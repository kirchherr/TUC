{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuc.dev/schemas/bounded_model_session_audit_report.v0.schema.json",
  "title": "TUC Bounded Model Session Audit Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_contract",
    "bitexact_scalar_checks",
    "blocked_claims",
    "consumer_sha256",
    "independent_organizational_evidence",
    "max_absolute_reference_difference",
    "model_digests_recomputed",
    "models_reconstructed",
    "native_execution_observed_in_receipt",
    "new_native_execution",
    "numpy_imported",
    "program_digests_bound",
    "receipt_bytes",
    "receipt_sha256",
    "records_checked",
    "request_bindings",
    "request_digests_recomputed",
    "scalar_checks",
    "schema_version",
    "source_commit",
    "status",
    "stdlib_only",
    "subprocess_execution",
    "third_party_dependencies",
    "tolerance_scalar_checks",
    "tuc_imported",
    "wheel_sha256"
  ],
  "properties": {
    "audit_contract": {"const": "bounded_model_session.receipt_reimplementation.stdlib.v0"},
    "bitexact_scalar_checks": {"const": 38},
    "blocked_claims": {
      "const": [
        "independent_organizational_reproduction",
        "arbitrary_models_or_inputs",
        "general_native_runtime_admission",
        "resident_model_weights",
        "native_performance"
      ]
    },
    "consumer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independent_organizational_evidence": {"const": false},
    "max_absolute_reference_difference": {"type": "number", "minimum": 0},
    "model_digests_recomputed": {"const": true},
    "models_reconstructed": {"const": 3},
    "native_execution_observed_in_receipt": {"const": true},
    "new_native_execution": {"const": false},
    "numpy_imported": {"const": false},
    "program_digests_bound": {"const": true},
    "receipt_bytes": {"const": 8508},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records_checked": {"const": 20},
    "request_bindings": {"const": 21},
    "request_digests_recomputed": {"const": true},
    "scalar_checks": {"const": 42},
    "schema_version": {"const": "tuc.bounded_model_session_audit_report.v0"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "PASS"},
    "stdlib_only": {"const": true},
    "subprocess_execution": {"const": false},
    "third_party_dependencies": {"const": false},
    "tolerance_scalar_checks": {"const": 4},
    "tuc_imported": {"const": false},
    "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
