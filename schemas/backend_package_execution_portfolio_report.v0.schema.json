{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/backend_package_execution_portfolio_report.v0.schema.json",
  "title": "TUC Backend Package Execution Portfolio Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocked_execution_surfaces",
    "entries",
    "equivalence_comparison_metadata_digest",
    "equivalence_contract",
    "equivalence_passed",
    "execution_mode",
    "execution_step_count",
    "executor_contract",
    "external_plugin_execution",
    "fallback_assignment_count",
    "graph_name",
    "layout_conversion_count",
    "layout_conversions",
    "output_dtypes",
    "output_shapes",
    "output_tensor_names",
    "package_admission_contract",
    "package_backend_count",
    "package_backend_implementation_executed",
    "physical_device_execution",
    "portfolio_admission_digest",
    "portfolio_contract",
    "portfolio_policy",
    "portfolio_status",
    "projected_backend_sequence",
    "projected_operation_count",
    "projected_plan_digest",
    "raw_tensor_value_policy",
    "schema_version",
    "source_all_assignments_package_bound",
    "source_backend_sequence",
    "source_plan_digest",
    "transfer_edge_count",
    "trusted_executor_count",
    "trusted_executor_registry"
  ],
  "properties": {
    "schema_version": { "const": "tuc.backend_package_execution_portfolio_report.v0" },
    "portfolio_contract": { "const": "backend_package_execution_portfolio.trusted_projection.v0" },
    "portfolio_policy": { "const": "all_assignments_package_bound_no_fallback" },
    "portfolio_status": { "const": "PASS" },
    "package_admission_contract": { "const": "backend_package_execution_admission.trusted_projection.v0" },
    "execution_mode": { "const": "trusted_reference_projection_only" },
    "executor_contract": { "const": "runtime_executor.trusted_backend.v0" },
    "equivalence_contract": { "const": "runtime_backend_equivalence.data_only.v0" },
    "trusted_executor_registry": { "const": "trusted_runtime_executor_registry.v0" },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/entry" }
    },
    "portfolio_admission_digest": { "$ref": "#/$defs/digest" },
    "graph_name": { "$ref": "#/$defs/identifier" },
    "source_plan_digest": { "$ref": "#/$defs/digest" },
    "projected_plan_digest": { "$ref": "#/$defs/digest" },
    "source_backend_sequence": { "$ref": "#/$defs/backend_sequence" },
    "projected_backend_sequence": { "$ref": "#/$defs/backend_sequence" },
    "package_backend_count": { "type": "integer", "minimum": 2, "maximum": 16 },
    "trusted_executor_count": { "type": "integer", "minimum": 2, "maximum": 16 },
    "fallback_assignment_count": { "const": 0 },
    "projected_operation_count": { "type": "integer", "minimum": 2, "maximum": 4096 },
    "transfer_edge_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "layout_conversion_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "layout_conversions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/layout_conversion" }
    },
    "execution_step_count": { "type": "integer", "minimum": 2, "maximum": 4096 },
    "output_tensor_names": { "$ref": "#/$defs/identifier_array" },
    "output_dtypes": { "$ref": "#/$defs/identifier_array" },
    "output_shapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": { "type": "integer", "minimum": 1 }
      }
    },
    "equivalence_comparison_metadata_digest": { "$ref": "#/$defs/digest" },
    "equivalence_passed": { "const": true },
    "source_all_assignments_package_bound": { "const": true },
    "raw_tensor_value_policy": { "const": "omitted_by_policy" },
    "external_plugin_execution": { "const": false },
    "package_backend_implementation_executed": { "const": false },
    "physical_device_execution": { "const": false },
    "blocked_execution_surfaces": {
      "const": [
        "backend_plugin_discovery",
        "device_access",
        "dynamic_import",
        "dynamic_library_loading",
        "generated_artifact_execution",
        "jit_execution",
        "network_access",
        "subprocess_execution"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend_sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "identifier_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_operations",
        "binding_id",
        "capability_manifest_digest",
        "package_admission_status",
        "package_backend_name",
        "package_digest",
        "package_id",
        "projection_execution_allowed",
        "trusted_executor_backend",
        "trusted_executor_contract_digest"
      ],
      "properties": {
        "allowed_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "binding_id": { "$ref": "#/$defs/identifier" },
        "capability_manifest_digest": { "$ref": "#/$defs/digest" },
        "package_admission_status": { "const": "ADMITTED" },
        "package_backend_name": { "$ref": "#/$defs/identifier" },
        "package_digest": { "$ref": "#/$defs/digest" },
        "package_id": { "$ref": "#/$defs/identifier" },
        "projection_execution_allowed": { "const": true },
        "trusted_executor_backend": { "$ref": "#/$defs/identifier" },
        "trusted_executor_contract_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "layout_conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes_converted",
        "source_layout",
        "target_layout",
        "target_operation",
        "tensor_name"
      ],
      "properties": {
        "bytes_converted": { "type": "integer", "minimum": 1 },
        "source_layout": { "$ref": "#/$defs/identifier" },
        "target_layout": { "$ref": "#/$defs/identifier" },
        "target_operation": { "$ref": "#/$defs/identifier" },
        "tensor_name": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
