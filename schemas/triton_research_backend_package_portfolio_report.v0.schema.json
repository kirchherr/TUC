{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/triton_research_backend_package_portfolio_report.v0.schema.json",
  "title": "TUC Triton Research Backend Package Portfolio Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_count",
    "artifact_policy",
    "artifacts",
    "execution",
    "frontend",
    "packages",
    "planning",
    "proof_claim",
    "proof_contract",
    "proof_status",
    "schema_version",
    "security",
    "source"
  ],
  "properties": {
    "artifact_count": { "const": 12 },
    "artifact_policy": { "const": "digest_only_source_payloads_and_values_omitted" },
    "artifacts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "$ref": "#/$defs/kernel_ingress_artifact" },
        { "$ref": "#/$defs/research_parser_artifact" },
        { "$ref": "#/$defs/source_intent_module_artifact" },
        { "$ref": "#/$defs/source_intent_metadata_artifact" },
        { "$ref": "#/$defs/hac_ir_artifact" },
        { "$ref": "#/$defs/external_systolic_artifact" },
        { "$ref": "#/$defs/external_vector_artifact" },
        { "$ref": "#/$defs/portfolio_artifact" },
        { "$ref": "#/$defs/output_contract_artifact" },
        { "$ref": "#/$defs/public_output_artifact" },
        { "$ref": "#/$defs/reference_correctness_artifact" },
        { "$ref": "#/$defs/backend_equivalence_artifact" }
      ],
      "items": false
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_equivalence_contract",
        "backend_equivalence_passed",
        "equivalence_comparison_metadata_digest",
        "physical_device_execution",
        "public_output_bundle_contract",
        "public_output_names",
        "raw_tensor_values_serialized",
        "reference_correctness_contract",
        "reference_correctness_passed",
        "terminal_output_names",
        "trusted_executor_registry"
      ],
      "properties": {
        "backend_equivalence_contract": { "const": "runtime_backend_equivalence.data_only.v0" },
        "backend_equivalence_passed": { "const": true },
        "equivalence_comparison_metadata_digest": { "$ref": "#/$defs/digest" },
        "physical_device_execution": { "const": false },
        "public_output_bundle_contract": { "const": "runtime_public_output_bundle.readonly_values.v0" },
        "public_output_names": { "const": ["y"] },
        "raw_tensor_values_serialized": { "const": false },
        "reference_correctness_contract": { "const": "runtime_reference_correctness.data_only.v0" },
        "reference_correctness_passed": { "const": true },
        "terminal_output_names": { "const": ["activated"] },
        "trusted_executor_registry": { "const": "trusted_runtime_executor_registry.v0" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_parser_status",
        "ingress_contract",
        "operation_families",
        "parser_contract",
        "parser_status",
        "source_intent_contract",
        "source_intent_digest",
        "source_intent_payload_serialized"
      ],
      "properties": {
        "default_parser_status": { "const": "default_parser_blocked" },
        "ingress_contract": { "const": "source_to_intent_research_kernel_ingress.execution_free.v0" },
        "operation_families": { "const": ["elementwise", "matmul"] },
        "parser_contract": { "const": "source_to_intent_research_parser.execution_free.v0" },
        "parser_status": { "const": "research_explicit_only" },
        "source_intent_contract": { "const": "source_intent_ir.canonical.v0" },
        "source_intent_digest": { "const": "sha256:20b83d9aebaf4b231ccb37c55171faef3ce258efb6fb0d8df422108fe1a7bb4f" },
        "source_intent_payload_serialized": { "const": false }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_package_code_executed",
        "external_plugin_execution",
        "integration_contract",
        "package_digests",
        "package_ids"
      ],
      "properties": {
        "external_package_code_executed": { "const": false },
        "external_plugin_execution": { "const": false },
        "integration_contract": { "const": "backend_integration.data_only.v0" },
        "package_digests": {
          "const": [
            "sha256:806813974dfde16b46f694566d751b18780d5e43d8455467bf4e5d7ea38b452c",
            "sha256:bf4bf333025a176f20ad927c249747f6ce923e14f224f4cd94ed769d893288ee"
          ]
        },
        "package_ids": {
          "const": [
            "external-systolic-reference-package",
            "external-vector-reference-package"
          ]
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_assignment_count",
        "hac_ir_contract",
        "layout_conversion_count",
        "package_admission_contract",
        "package_backend_sequence",
        "portfolio_contract",
        "trusted_executor_sequence"
      ],
      "properties": {
        "fallback_assignment_count": { "const": 0 },
        "hac_ir_contract": { "const": "hac-ir.v0" },
        "layout_conversion_count": { "const": 1 },
        "package_admission_contract": { "const": "backend_package_execution_admission.trusted_projection.v0" },
        "package_backend_sequence": { "const": ["external-systolic", "external-vector"] },
        "portfolio_contract": { "const": "backend_package_execution_portfolio.trusted_projection.v0" },
        "trusted_executor_sequence": { "const": ["systolic-sim", "vector-sim"] }
      }
    },
    "proof_claim": { "const": "bounded_triton_research_source_reaches_no_fallback_external_package_execution" },
    "proof_contract": { "const": "triton_research_backend_package_portfolio.e2e.v0" },
    "proof_status": { "const": "PASS" },
    "schema_version": { "const": "tuc.triton_research_backend_package_portfolio_report.v0" },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_claims",
        "blocked_execution_surfaces",
        "production_source_ingestion_admitted"
      ],
      "properties": {
        "blocked_claims": {
          "const": [
            "general_triton_source_ingestion",
            "production_parser",
            "production_source_ingestion_admission",
            "external_package_code_execution",
            "native_backend_execution",
            "physical_device_residency",
            "native_performance_parity"
          ]
        },
        "blocked_execution_surfaces": {
          "const": [
            "backend_artifact_execution",
            "backend_plugin_discovery",
            "bytecode_compilation",
            "decorator_evaluation",
            "device_access",
            "dynamic_import",
            "dynamic_library_loading",
            "environment_dependent_behavior",
            "file_system_access",
            "frontend_module_import",
            "generated_artifact_execution",
            "jit_execution",
            "module_import_execution",
            "module_top_level_execution",
            "network_access",
            "plugin_discovery",
            "python_function_inspection",
            "python_function_object_ingestion",
            "subprocess_execution",
            "triton_jit_execution"
          ]
        },
        "production_source_ingestion_admitted": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decorator_evaluated",
        "extracted_kernel_digest",
        "import_count",
        "jit_executed",
        "kernel_name",
        "module_ast_depth",
        "module_ast_node_count",
        "module_bytes",
        "module_digest",
        "module_imports_executed",
        "module_line_count",
        "source_boundary",
        "source_name",
        "source_text_executed",
        "source_text_serialized"
      ],
      "properties": {
        "decorator_evaluated": { "const": false },
        "extracted_kernel_digest": { "const": "sha256:ad113b078fe24fcd871fbfb3f95b03e6192dbad3e607bbb737a9e09aa92f9bad" },
        "import_count": { "const": 2 },
        "jit_executed": { "const": false },
        "kernel_name": { "const": "matmul_elementwise" },
        "module_ast_depth": { "const": 7 },
        "module_ast_node_count": { "const": 52 },
        "module_bytes": { "const": 206 },
        "module_digest": { "const": "sha256:eb599f41b7abee29e06c0842db8ba43fc8e8b710f668532a767c31fd81d7f7a0" },
        "module_imports_executed": { "const": false },
        "module_line_count": { "const": 8 },
        "source_boundary": { "const": "bounded_triton_module_text_to_external_package_portfolio_research_only" },
        "source_name": { "const": "research_matmul_elementwise" },
        "source_text_executed": { "const": false },
        "source_text_serialized": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "contract", "digest", "status"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact_kind": { "enum": ["json_report", "text_dump", "text_report"] },
        "contract": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "accepted" }
      }
    },
    "kernel_ingress_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "kernel_ingress" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "source_to_intent_research_kernel_ingress.execution_free.v0" } } }] },
    "research_parser_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "research_parser" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "source_to_intent_research_parser.execution_free.v0" } } }] },
    "source_intent_module_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "source_intent_module" }, "artifact_kind": { "const": "text_dump" }, "contract": { "const": "source_intent_ir.canonical.v0" } } }] },
    "source_intent_metadata_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "source_intent_metadata" }, "artifact_kind": { "const": "text_report" }, "contract": { "const": "source_intent_to_metadata.execution_free.v0" } } }] },
    "hac_ir_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "hac_ir" }, "artifact_kind": { "const": "text_dump" }, "contract": { "const": "hac-ir.v0" } } }] },
    "external_systolic_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "external_systolic_integration" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "backend_integration.data_only.v0" } } }] },
    "external_vector_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "external_vector_integration" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "backend_integration.data_only.v0" } } }] },
    "portfolio_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "package_portfolio_execution" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "backend_package_execution_portfolio.trusted_projection.v0" } } }] },
    "output_contract_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "public_output_contract" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "runtime_output_contract.data_only.v0" } } }] },
    "public_output_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "public_output_bundle" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "runtime_public_output_bundle.readonly_values.v0" } } }] },
    "reference_correctness_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "reference_correctness" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "runtime_reference_correctness.data_only.v0" } } }] },
    "backend_equivalence_artifact": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "artifact_id": { "const": "backend_equivalence" }, "artifact_kind": { "const": "json_report" }, "contract": { "const": "runtime_backend_equivalence.data_only.v0" } } }] }
  }
}
