{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_to_intent_research_kernel_ingress_proof_bundle_report.v0.schema.json",
  "title": "TUC Source-To-Intent Research Kernel Ingress Proof Bundle Report v0",
  "description": "Digest-only review bundle for Kernel Ingress research evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_kernel_names",
    "accepted_source_names",
    "artifact_count",
    "artifact_policy",
    "artifacts",
    "blocked_claims",
    "bundle_contract",
    "claim",
    "covered_operation_families",
    "default_parser_status",
    "parser_status",
    "required_artifacts",
    "review_claims",
    "schema_version",
    "source_boundary",
    "status"
  ],
  "properties": {
    "accepted_kernel_names": {
      "type": "array",
      "prefixItems": [
        {
          "const": "matmul_elementwise"
        },
        {
          "const": "softmax_reduction"
        },
        {
          "const": "matmul_reduction"
        },
        {
          "const": "mvp_pipeline"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "accepted_source_names": {
      "type": "array",
      "prefixItems": [
        {
          "const": "research_matmul_elementwise"
        },
        {
          "const": "research_softmax_reduction"
        },
        {
          "const": "research_matmul_reduction"
        },
        {
          "const": "research_mvp_pipeline"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "artifact_count": {
      "const": 15
    },
    "artifact_policy": {
      "const": "digest_only_source_free"
    },
    "artifacts": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "blocked_claims": {
      "type": "array",
      "prefixItems": [
        {
          "const": "general_triton_source_ingestion"
        },
        {
          "const": "native_performance_claim"
        },
        {
          "const": "production_parser"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "bundle_contract": {
      "const": "source_to_intent_research_kernel_ingress_proof_bundle.review.v0"
    },
    "claim": {
      "const": "realistic_triton_module_ingress_research_slice"
    },
    "covered_operation_families": {
      "type": "array",
      "prefixItems": [
        {
          "const": "elementwise"
        },
        {
          "const": "matmul"
        },
        {
          "const": "reduction"
        },
        {
          "const": "softmax"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "default_parser_status": {
      "const": "default_parser_blocked"
    },
    "parser_status": {
      "const": "research_explicit_only"
    },
    "required_artifacts": {
      "type": "array",
      "prefixItems": [
        {
          "const": "source_to_intent_research_kernel_ingress"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_matrix"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_step_trace"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_evidence_bundle_index"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_output_closure_index"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_replay_verifier_index"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_backend_equivalence"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_backend_equivalence_shape_profiles"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_coverage_policy"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_runtime_backend_alignment"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_boundary_budget"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_rejection_coverage"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_diagnostics"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_conformance_gate"
        },
        {
          "const": "source_to_intent_research_kernel_ingress_idiom_alignment"
        }
      ],
      "minItems": 15,
      "maxItems": 15
    },
    "review_claims": {
      "type": "array",
      "prefixItems": [
        {
          "const": "conformance_bound"
        },
        {
          "const": "boundary_budget_bound"
        },
        {
          "const": "rejection_coverage_bound"
        },
        {
          "const": "diagnostics_bound"
        },
        {
          "const": "idiom_scope_bound"
        },
        {
          "const": "kernel_ingress_runtime_e2e"
        },
        {
          "const": "runtime_matrix_bound"
        },
        {
          "const": "runtime_step_trace_bound"
        },
        {
          "const": "runtime_evidence_bundle_index_bound"
        },
        {
          "const": "runtime_output_closure_index_bound"
        },
        {
          "const": "runtime_replay_verifier_index_bound"
        },
        {
          "const": "runtime_backend_equivalence_bound"
        },
        {
          "const": "runtime_backend_equivalence_shape_profiles_bound"
        },
        {
          "const": "runtime_coverage_policy_bound"
        },
        {
          "const": "runtime_backend_alignment_bound"
        },
        {
          "const": "source_free_metadata_only"
        }
      ],
      "minItems": 16,
      "maxItems": 16
    },
    "schema_version": {
      "const": "tuc.source_to_intent_research_kernel_ingress_proof_bundle_report.v0"
    },
    "source_boundary": {
      "const": "triton_module_source_buffer_to_source_intent_to_runtime_metadata_only"
    },
    "status": {
      "const": "PASS"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "contract",
        "digest",
        "status"
      ],
      "properties": {
        "artifact_id": {
          "enum": [
            "source_to_intent_research_kernel_ingress",
            "source_to_intent_research_kernel_ingress_runtime_matrix",
            "source_to_intent_research_kernel_ingress_runtime_step_trace",
            "source_to_intent_research_kernel_ingress_runtime_evidence_bundle_index",
            "source_to_intent_research_kernel_ingress_runtime_output_closure_index",
            "source_to_intent_research_kernel_ingress_runtime_replay_verifier_index",
            "source_to_intent_research_kernel_ingress_backend_equivalence",
            "source_to_intent_research_kernel_ingress_backend_equivalence_shape_profiles",
            "source_to_intent_research_kernel_ingress_runtime_coverage_policy",
            "source_to_intent_research_kernel_ingress_runtime_backend_alignment",
            "source_to_intent_research_kernel_ingress_boundary_budget",
            "source_to_intent_research_kernel_ingress_rejection_coverage",
            "source_to_intent_research_kernel_ingress_diagnostics",
            "source_to_intent_research_kernel_ingress_conformance_gate",
            "source_to_intent_research_kernel_ingress_idiom_alignment"
          ]
        },
        "artifact_kind": {
          "enum": [
            "json_report",
            "text_gate"
          ]
        },
        "contract": {
          "$ref": "#/$defs/report_text"
        },
        "digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "status": {
          "const": "accepted"
        }
      }
    },
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
