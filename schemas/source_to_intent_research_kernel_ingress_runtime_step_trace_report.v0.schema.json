{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_to_intent_research_kernel_ingress_runtime_step_trace_report.v0.schema.json",
  "title": "TUC Source-To-Intent Research Kernel Ingress Runtime Step Trace Report v0",
  "description": "Source-free operation-level runtime step trace evidence for Kernel Ingress research cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_policy",
    "blocked_execution_surfaces",
    "case_count",
    "cases",
    "default_parser_status",
    "executor_contract",
    "frontend_ingress_contract",
    "kernel_ingress_digest",
    "parser_status",
    "raw_source_policy",
    "raw_value_policy",
    "runtime_matrix_contract",
    "runtime_matrix_digest",
    "runtime_step_trace_contract",
    "schema_version",
    "source_boundary",
    "status",
    "trusted_executor_registry"
  ],
  "properties": {
    "artifact_policy": {"const": "metadata_only_values_omitted"},
    "blocked_execution_surfaces": {
      "type": "array",
      "prefixItems": [
        {"const": "backend_plugin_discovery"},
        {"const": "device_access"},
        {"const": "dynamic_import"},
        {"const": "dynamic_library_loading"},
        {"const": "generated_artifact_execution"},
        {"const": "jit_execution"},
        {"const": "network_access"},
        {"const": "subprocess_execution"}
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "case_count": {"const": 5},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"},
      "minItems": 5,
      "maxItems": 5
    },
    "default_parser_status": {"const": "default_parser_blocked"},
    "executor_contract": {"const": "runtime_executor.trusted_backend.v0"},
    "frontend_ingress_contract": {
      "const": "source_to_intent_research_kernel_ingress.execution_free.v0"
    },
    "kernel_ingress_digest": {"$ref": "#/$defs/sha256_digest"},
    "parser_status": {"const": "research_explicit_only"},
    "raw_source_policy": {"const": "omitted_by_policy"},
    "raw_value_policy": {"const": "omitted_by_policy"},
    "runtime_matrix_contract": {
      "const": "source_to_intent_research_kernel_ingress_runtime_matrix.execution.v0"
    },
    "runtime_matrix_digest": {"$ref": "#/$defs/sha256_digest"},
    "runtime_step_trace_contract": {
      "const": "source_to_intent_research_kernel_ingress_runtime_step_trace.execution.v0"
    },
    "schema_version": {
      "const": "tuc.source_to_intent_research_kernel_ingress_runtime_step_trace_report.v0"
    },
    "source_boundary": {"const": "kernel_ingress_runtime_execution_trace_metadata"},
    "status": {"const": "PASS"},
    "trusted_executor_registry": {"const": "trusted_runtime_executor_registry.v0"}
  },
  "$defs": {
    "backend": {"enum": ["linear-sim", "vector-sim"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_sequence",
        "case_id",
        "execution_trace_digest",
        "kernel_name",
        "operation_path",
        "runtime_plan_digest",
        "status",
        "step_count",
        "steps",
        "terminal_outputs"
      ],
      "properties": {
        "backend_sequence": {
          "type": "array",
          "items": {"$ref": "#/$defs/backend"},
          "minItems": 2,
          "maxItems": 4
        },
        "case_id": {
          "enum": [
            "research_module_matmul_elementwise",
            "research_module_softmax_reduction",
            "research_module_matmul_reduction",
            "research_module_softmax_elementwise",
            "research_module_mvp_pipeline"
          ]
        },
        "execution_trace_digest": {"$ref": "#/$defs/sha256_digest"},
        "kernel_name": {
          "enum": [
            "matmul_elementwise",
            "softmax_reduction",
            "matmul_reduction",
            "softmax_elementwise",
            "mvp_pipeline"
          ]
        },
        "operation_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation_kind"},
          "minItems": 2,
          "maxItems": 4
        },
        "runtime_plan_digest": {"$ref": "#/$defs/sha256_digest"},
        "status": {"const": "traced"},
        "step_count": {"enum": [2, 4]},
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"},
          "minItems": 2,
          "maxItems": 4
        },
        "terminal_outputs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "operation_kind": {
      "enum": ["elementwise", "matmul", "reduction", "softmax"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_backend",
        "input_tensors",
        "operation_kind",
        "operation_name",
        "output_dtypes",
        "output_shapes",
        "output_tensors",
        "planned_backend",
        "status",
        "step_index"
      ],
      "properties": {
        "executor_backend": {"$ref": "#/$defs/backend"},
        "input_tensors": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 2
        },
        "operation_kind": {"$ref": "#/$defs/operation_kind"},
        "operation_name": {
          "enum": [
            "activated",
            "column_sum",
            "normalized",
            "projection",
            "row_sum",
            "stable"
          ]
        },
        "output_dtypes": {
          "type": "array",
          "items": {"const": "float64"},
          "minItems": 1,
          "maxItems": 1
        },
        "output_shapes": {
          "type": "array",
          "items": {"$ref": "#/$defs/tensor_shape"},
          "minItems": 1,
          "maxItems": 1
        },
        "output_tensors": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 1
        },
        "planned_backend": {"$ref": "#/$defs/backend"},
        "status": {"const": "executed"},
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "tensor_shape": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "minItems": 1,
      "maxItems": 2
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
