{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/oci_source_ingestion_research_proof_report.v0.schema.json",
  "title": "TUC OCI Source Ingestion Research Proof Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_policy",
    "backend_equivalence_passed",
    "base_image",
    "blocked_claims",
    "compose_contract_digest",
    "direct_source_ingestion",
    "dockerfile_digest",
    "external_package_code_executed",
    "fallback_assignment_count",
    "filesystem_namespace_isolation",
    "kernel_network_isolation",
    "malicious_source_executed",
    "malicious_source_rejected",
    "negative_case_count",
    "no_new_privileges",
    "numpy_version",
    "numpy_wheel_digest",
    "operation_families",
    "production_source_ingestion",
    "production_source_sandbox",
    "proof_claim",
    "proof_contract",
    "proof_status",
    "published_worker_image_provenance",
    "raw_source_serialized",
    "raw_tensor_values_serialized",
    "reference_correctness_passed",
    "report_digest",
    "repository_bind_mount",
    "requirements_digest",
    "rejection_reason_code",
    "rejection_request_digest",
    "root_filesystem_read_only",
    "schema_version",
    "seccomp_mode",
    "source_intent_digest",
    "source_intent_matches_vertical_proof",
    "source_intent_payload_serialized",
    "source_text_executed",
    "trusted_executor_sequence",
    "vertical_proof_digest",
    "worker_protocol",
    "worker_request_digest",
    "worker_source_digest"
  ],
  "properties": {
    "artifact_policy": { "const": "metadata_digest_only_source_and_values_omitted" },
    "backend_equivalence_passed": { "const": true },
    "base_image": { "const": "python:3.12-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2" },
    "blocked_claims": {
      "const": [
        "general_triton_parser",
        "native_backend_execution",
        "native_performance_parity",
        "production_source_ingestion",
        "production_source_sandbox",
        "published_worker_image_provenance"
      ]
    },
    "compose_contract_digest": { "$ref": "#/$defs/digest" },
    "direct_source_ingestion": { "const": false },
    "dockerfile_digest": { "$ref": "#/$defs/digest" },
    "external_package_code_executed": { "const": false },
    "fallback_assignment_count": { "const": 0 },
    "filesystem_namespace_isolation": { "const": true },
    "kernel_network_isolation": { "const": true },
    "malicious_source_executed": { "const": false },
    "malicious_source_rejected": { "const": true },
    "negative_case_count": { "const": 1 },
    "no_new_privileges": { "const": true },
    "numpy_version": { "const": "2.4.4" },
    "numpy_wheel_digest": { "const": "sha256:81f4a14bee47aec54f883e0cad2d73986640c1590eb9bfaaba7ad17394481e6e" },
    "operation_families": { "const": ["elementwise", "matmul"] },
    "production_source_ingestion": { "const": false },
    "production_source_sandbox": { "const": false },
    "proof_claim": { "const": "bounded_source_intent_crosses_kernel_isolated_worker_and_matches_vertical_proof" },
    "proof_contract": { "const": "oci_source_ingestion_research_proof.kernel_isolated.v0" },
    "proof_status": { "const": "PASS" },
    "published_worker_image_provenance": { "const": false },
    "raw_source_serialized": { "const": false },
    "raw_tensor_values_serialized": { "const": false },
    "reference_correctness_passed": { "const": true },
    "report_digest": { "$ref": "#/$defs/digest" },
    "repository_bind_mount": { "const": false },
    "requirements_digest": { "$ref": "#/$defs/digest" },
    "rejection_reason_code": { "const": "source_rejected" },
    "rejection_request_digest": { "$ref": "#/$defs/digest" },
    "root_filesystem_read_only": { "const": true },
    "schema_version": { "const": "tuc.oci_source_ingestion_research_proof_report.v0" },
    "seccomp_mode": { "const": 2 },
    "source_intent_digest": { "$ref": "#/$defs/digest" },
    "source_intent_matches_vertical_proof": { "const": true },
    "source_intent_payload_serialized": { "const": false },
    "source_text_executed": { "const": false },
    "trusted_executor_sequence": { "const": ["systolic-sim", "vector-sim"] },
    "vertical_proof_digest": { "$ref": "#/$defs/digest" },
    "worker_protocol": { "const": "tuc.oci_source_ingestion_worker.v0" },
    "worker_request_digest": { "$ref": "#/$defs/digest" },
    "worker_source_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
