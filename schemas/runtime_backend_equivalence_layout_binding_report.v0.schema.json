{
  "$id": "https://tuc.dev/schemas/runtime_backend_equivalence_layout_binding_report.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_status": {"const": "review_binding"},
    "backend_equivalence_comparison_metadata_digest": {
      "$ref": "#/$defs/sha256_digest"
    },
    "backend_equivalence_report_digest": {"$ref": "#/$defs/sha256_digest"},
    "baseline_backend_sequence_digest": {"$ref": "#/$defs/sha256_digest"},
    "baseline_run_id": {"$ref": "#/$defs/report_text"},
    "binding_contract": {
      "const": "runtime_backend_equivalence_layout_binding.data_only.v0"
    },
    "binding_metadata_digest": {"$ref": "#/$defs/sha256_digest"},
    "binding_mode": {"const": "metadata_digest_binding_only"},
    "blocked_execution_surfaces": {
      "items": false,
      "maxItems": 8,
      "minItems": 8,
      "prefixItems": [
        {"const": "backend_plugin_discovery"},
        {"const": "device_access"},
        {"const": "dynamic_import"},
        {"const": "dynamic_library_loading"},
        {"const": "generated_artifact_execution"},
        {"const": "jit_execution"},
        {"const": "network_access"},
        {"const": "subprocess_execution"}
      ],
      "type": "array"
    },
    "candidate_backend_count": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "candidate_backend_sequence_digest": {"$ref": "#/$defs/sha256_digest"},
    "candidate_run_id": {"$ref": "#/$defs/report_text"},
    "check_count": {"const": 8},
    "checks": {
      "items": {"$ref": "#/$defs/check"},
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "executor_contract": {"const": "runtime_executor.trusted_backend.v0"},
    "graph_name": {"$ref": "#/$defs/report_text"},
    "input_policy": {"const": "serialized_json_reports_only"},
    "issues": {
      "items": {"$ref": "#/$defs/issue"},
      "maxItems": 64,
      "type": "array"
    },
    "layout_replay_check_count": {"const": 6},
    "layout_trace_replay_metadata_digest": {"$ref": "#/$defs/sha256_digest"},
    "layout_trace_replay_report_digest": {"$ref": "#/$defs/sha256_digest"},
    "passed": {"type": "boolean"},
    "raw_value_policy": {"const": "omitted_by_policy"},
    "reexecution_policy": {"const": "runtime_reexecution_not_required"},
    "required_inputs": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {"const": "runtime_backend_equivalence"},
        {"const": "runtime_layout_conversion_trace_replay_verifier"}
      ],
      "type": "array"
    },
    "schema_version": {
      "const": "tuc.runtime_backend_equivalence_layout_binding_report.v0"
    },
    "trusted_executor_registry": {
      "const": "trusted_runtime_executor_registry.v0"
    }
  },
  "required": [
    "artifact_status",
    "backend_equivalence_comparison_metadata_digest",
    "backend_equivalence_report_digest",
    "baseline_backend_sequence_digest",
    "baseline_run_id",
    "binding_contract",
    "binding_metadata_digest",
    "binding_mode",
    "blocked_execution_surfaces",
    "candidate_backend_count",
    "candidate_backend_sequence_digest",
    "candidate_run_id",
    "check_count",
    "checks",
    "executor_contract",
    "graph_name",
    "input_policy",
    "issues",
    "layout_replay_check_count",
    "layout_trace_replay_metadata_digest",
    "layout_trace_replay_report_digest",
    "passed",
    "raw_value_policy",
    "reexecution_policy",
    "required_inputs",
    "schema_version",
    "trusted_executor_registry"
  ],
  "type": "object",
  "$defs": {
    "check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "backend_equivalence_contract_bound",
            "layout_trace_replay_contract_bound",
            "graph_name_bound",
            "backend_equivalence_passed_bound",
            "layout_trace_replay_passed_bound",
            "raw_value_policy_bound",
            "candidate_backend_diversity_bound",
            "layout_replay_checks_bound"
          ]
        },
        "expected": {
          "anyOf": [
            {"$ref": "#/$defs/sha256_digest"},
            {"$ref": "#/$defs/report_text"}
          ]
        },
        "observed": {
          "anyOf": [
            {"$ref": "#/$defs/sha256_digest"},
            {"$ref": "#/$defs/report_text"}
          ]
        },
        "row_status": {"const": "verified"},
        "subject": {
          "enum": [
            "runtime_backend_equivalence",
            "runtime_backend_equivalence_layout_binding",
            "runtime_layout_conversion_trace_replay_verifier"
          ]
        }
      },
      "required": ["check_id", "expected", "observed", "row_status", "subject"],
      "type": "object"
    },
    "issue": {
      "additionalProperties": false,
      "properties": {
        "issue_code": {"$ref": "#/$defs/report_text"},
        "subject": {"$ref": "#/$defs/report_text"}
      },
      "required": ["issue_code", "subject"],
      "type": "object"
    },
    "report_text": {
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string",
      "not": {
        "enum": [
          "allocation_handle",
          "backend_artifact",
          "command_line",
          "device_id",
          "device_pointer",
          "dynamic_library",
          "environment",
          "executable",
          "file_path",
          "generated_code",
          "host_path",
          "jit_function",
          "memory_address",
          "network",
          "plugin_entrypoint",
          "python_module",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value",
          "url"
        ]
      }
    },
    "sha256_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
