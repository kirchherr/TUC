{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_to_intent_research_kernel_ingress_boundary_budget_report.v0.schema.json",
  "title": "TUC Source-To-Intent Research Kernel Ingress Boundary Budget Report v0",
  "description": "Source-free budget and fail-closed boundary evidence for Kernel Ingress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_case_count",
    "accepted_observations",
    "artifact_policy",
    "blocked_compiler_outputs",
    "blocked_execution_surfaces",
    "boundary_contract",
    "budget_policy",
    "budget_rejection_case_count",
    "budget_rejection_cases",
    "default_parser_status",
    "diagnostics_budget_limits",
    "diagnostics_contract",
    "frontend_ingress_contract",
    "ingress_budget_limits",
    "input_policy",
    "parser_status",
    "raw_source_policy",
    "raw_value_policy",
    "schema_version",
    "source_boundary",
    "status"
  ],
  "properties": {
    "accepted_case_count": {"const": 4},
    "accepted_observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/observation"}
    },
    "artifact_policy": {"const": "metadata_only_values_omitted"},
    "blocked_compiler_outputs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/report_text"}
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/report_text"}
    },
    "boundary_contract": {
      "const": "source_to_intent_research_kernel_ingress_boundary_budget.security.v0"
    },
    "budget_policy": {"const": "fail_closed_before_extraction_or_lowering"},
    "budget_rejection_case_count": {"const": 2},
    "budget_rejection_cases": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "limit", "observed", "reason_fragment", "status"],
          "properties": {
            "case_id": {"const": "module_byte_budget"},
            "limit": {"const": 65536},
            "observed": {"const": 65537},
            "reason_fragment": {"const": "module source byte budget exceeded"},
            "status": {"const": "rejected"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "limit", "observed", "reason_fragment", "status"],
          "properties": {
            "case_id": {"const": "module_line_budget"},
            "limit": {"const": 2048},
            "observed": {"const": 2049},
            "reason_fragment": {"const": "module source line budget exceeded"},
            "status": {"const": "rejected"}
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "default_parser_status": {"const": "default_parser_blocked"},
    "diagnostics_budget_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "module_bytes", "report_bytes"],
      "properties": {
        "case_count": {"const": 32},
        "module_bytes": {"const": 65536},
        "report_bytes": {"const": 131072}
      }
    },
    "diagnostics_contract": {
      "const": "source_to_intent_research_kernel_ingress_diagnostics.execution_free.v0"
    },
    "frontend_ingress_contract": {
      "const": "source_to_intent_research_kernel_ingress.execution_free.v0"
    },
    "ingress_budget_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_ast_depth",
        "module_ast_nodes",
        "module_bytes",
        "module_lines"
      ],
      "properties": {
        "module_ast_depth": {"const": 64},
        "module_ast_nodes": {"const": 8192},
        "module_bytes": {"const": 65536},
        "module_lines": {"const": 2048}
      }
    },
    "input_policy": {"const": "single_triton_module_source_buffer_only"},
    "parser_status": {"const": "research_explicit_only"},
    "raw_source_policy": {"const": "omitted_by_policy"},
    "raw_value_policy": {"const": "omitted_by_policy"},
    "schema_version": {
      "const": "tuc.source_to_intent_research_kernel_ingress_boundary_budget_report.v0"
    },
    "source_boundary": {"const": "triton_module_source_buffer_as_untrusted_data"},
    "status": {"const": "PASS"}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "import_count",
        "kernel_name",
        "module_ast_depth",
        "module_ast_node_count",
        "module_bytes",
        "module_line_count",
        "operation_families",
        "source_name",
        "status",
        "top_level_function_count"
      ],
      "properties": {
        "case_id": {
          "enum": [
            "accepted_research_matmul_elementwise",
            "accepted_research_softmax_reduction",
            "accepted_research_matmul_reduction",
            "accepted_research_mvp_pipeline"
          ]
        },
        "import_count": {"const": 2},
        "kernel_name": {
          "enum": [
            "matmul_elementwise",
            "softmax_reduction",
            "matmul_reduction",
            "mvp_pipeline"
          ]
        },
        "module_ast_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "module_ast_node_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "module_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "module_line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "operation_families": {
          "type": "array",
          "items": {
            "enum": ["elementwise", "matmul", "reduction", "softmax"]
          },
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true
        },
        "source_name": {
          "enum": [
            "research_matmul_elementwise",
            "research_softmax_reduction",
            "research_matmul_reduction",
            "research_mvp_pipeline"
          ]
        },
        "status": {"const": "within_budget"},
        "top_level_function_count": {"const": 1}
      }
    },
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
