    "required_invariants": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "stable_public_bundle_anchor" },
        { "const": "passing_extension_policy_anchor" },
        { "const": "fixed_initial_catalog_entries" },
        { "const": "append_only_rfc_bound_growth" },
        { "const": "digest_only_catalog_entries" },
        { "const": "source_free_public_reports" },
        { "const": "blocked_execution_surfaces_preserved" },
        { "const": "blocked_claims_preserved" }
      ]
    },
    "required_controls": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "schema_versioned_extension_artifacts" },
        { "const": "sha256_metadata_digests" },
        { "const": "source_free_public_reports" },
        { "const": "digest_only_public_links" },
        { "const": "no_execution_handles" },
        { "const": "no_device_access" },
        { "const": "no_generated_artifact_execution" },
        { "const": "no_native_performance_claim" }
      ]
    },
    "blocked_changes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "increase_public_bundle_capacity_without_rfc" },
        { "const": "replace_public_bundle_entries_without_rfc" },
        { "const": "add_source_buffers_to_public_artifacts" },
        { "const": "add_tensor_values_to_public_artifacts" },
        { "const": "authorize_execution_handles" },
        { "const": "authorize_device_access" },
        { "const": "authorize_generated_artifact_execution" },
        { "const": "claim_native_performance" }
      ]
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "native_performance_parity" },
        { "const": "vendor_compiler_replacement" },
        { "const": "broad_source_code_parsing" },
        { "const": "arbitrary_third_party_backend_execution" },
        { "const": "device_access" },
        { "const": "generated_artifact_execution" }
      ]
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "backend_plugin_discovery" },
        { "const": "device_access" },
        { "const": "dynamic_import" },
        { "const": "dynamic_library_loading" },
        { "const": "generated_artifact_execution" },
        { "const": "jit_execution" },
        { "const": "network_access" },
        { "const": "subprocess_execution" }
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/report_text" }
    }
  },
  "$defs": {
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/ -]*$",
      "maxLength": 256,
      "not": {
        "enum": [
          "backend_artifact",
          "command_line",
          "device_id",
          "dynamic_library",
          "generated_code",
          "host_path",
          "plugin_entrypoint",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value"
        ]
      }
    }
  }
