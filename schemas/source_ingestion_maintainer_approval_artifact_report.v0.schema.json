{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_ingestion_maintainer_approval_artifact_report.v0.schema.json",
  "title": "TUC Source Ingestion Maintainer Approval Artifact Report v0",
  "description": "Fail-closed status artifact proving that external maintainer approval has not been supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_effect",
    "admitted",
    "approval_artifact_present",
    "approval_decision",
    "approval_required",
    "approval_status",
    "artifact_policy",
    "blocked_execution_surfaces",
    "contract",
    "criteria_bound_by_review_packet",
    "direct_source_ingestion",
    "evidence_id",
    "execution_permission",
    "external_approval_artifact_present",
    "issues",
    "maintainer_review_packet",
    "remaining_external_evidence",
    "remaining_external_evidence_count",
    "report_digest",
    "required_control_count",
    "required_controls",
    "schema_version",
    "source_ingestion_admission_ready",
    "source_to_compute_graph",
    "source_to_hac_ir",
    "source_to_runtime_plan",
    "status",
    "target_slice",
    "target_surface"
  ],
  "properties": {
    "schema_version": {
      "const": "tuc.source_ingestion_maintainer_approval_artifact_report.v0"
    },
    "evidence_id": {
      "const": "source_ingestion_maintainer_approval_artifact"
    },
    "contract": {
      "const": "source_ingestion_maintainer_approval_artifact.absent.v0"
    },
    "status": {"const": "external_approval_not_supplied"},
    "approval_status": {"const": "not_approved"},
    "approval_decision": {"const": "deny_until_external_approval"},
    "approval_required": {"const": true},
    "approval_artifact_present": {"const": false},
    "external_approval_artifact_present": {"const": false},
    "criteria_bound_by_review_packet": {"const": true},
    "admitted": {"const": false},
    "target_surface": {"const": "direct_source_ingestion"},
    "target_slice": {"const": "bounded_source_buffer_to_source_intent_plain_data"},
    "artifact_policy": {"const": "digest_only_source_free"},
    "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
    "direct_source_ingestion": {"const": false},
    "source_ingestion_admission_ready": {"const": false},
    "source_to_compute_graph": {"const": false},
    "source_to_hac_ir": {"const": false},
    "source_to_runtime_plan": {"const": false},
    "execution_permission": {"const": "not_granted"},
    "remaining_external_evidence_count": {"const": 1},
    "required_control_count": {"const": 10},
    "report_digest": {"$ref": "#/$defs/sha256_text"},
    "issues": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "remaining_external_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"const": "maintainer_security_review_approval"}
      ],
      "items": false
    },
    "required_controls": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "maintainer_review_packet_bound"},
        {"const": "approval_criteria_bound_by_review_packet"},
        {"const": "external_approval_artifact_required"},
        {"const": "external_approval_artifact_absent"},
        {"const": "no_source_text_serialization"},
        {"const": "no_source_intent_payload_serialization"},
        {"const": "no_runtime_handle_serialization"},
        {"const": "no_generated_artifacts"},
        {"const": "approval_not_granted"},
        {"const": "fail_closed_until_approval"}
      ],
      "items": false
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "frontend_package_import"},
        {"const": "plugin_discovery"},
        {"const": "triton_jit_execution"},
        {"const": "device_access"},
        {"const": "generated_artifact_execution"},
        {"const": "native_backend_execution"},
        {"const": "python_import"},
        {"const": "network_access"},
        {"const": "subprocess_execution"},
        {"const": "dynamic_library_loading"}
      ],
      "items": false
    },
    "maintainer_review_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "criteria_bound",
        "digest",
        "evidence_id",
        "reviewable",
        "source_free",
        "status"
      ],
      "properties": {
        "contract": {
          "const": "source_ingestion_maintainer_security_review_packet.review.v0"
        },
        "criteria_bound": {"const": true},
        "digest": {"$ref": "#/$defs/sha256_text"},
        "evidence_id": {
          "const": "source_ingestion_maintainer_security_review_packet"
        },
        "reviewable": {"const": true},
        "source_free": {"const": true},
        "status": {"const": "ready_for_maintainer_review"}
      }
    }
  },
  "$defs": {
    "sha256_text": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
