{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_to_intent_next_syntax_report.v0.schema.json",
  "title": "TUC Source-To-Intent Next Syntax Report v0",
  "description": "Data-only semantic mapping evidence for the next Source-to-Intent parser syntax slice without opening default source ingestion or JIT execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_status",
    "blocked_compiler_outputs",
    "blocked_execution_surfaces",
    "case_count",
    "cases",
    "default_parser_status",
    "direct_source_ingestion",
    "golden_policy",
    "mapping_contract",
    "parser_contract",
    "parser_output_policy",
    "parser_rfc",
    "parser_status",
    "properties",
    "property_count",
    "property_coverage_complete",
    "schema_version",
    "source_intent_contract",
    "source_intent_schema_version",
    "syntax_slice",
    "triton_jit_execution"
  ],
  "properties": {
    "artifact_status": {"const": "review_evidence_only"},
    "blocked_compiler_outputs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/report_text"},
      "uniqueItems": true
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/report_text"},
      "uniqueItems": true
    },
    "case_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/case"}
    },
    "default_parser_status": {"const": "default_parser_blocked"},
    "direct_source_ingestion": {"const": false},
    "golden_policy": {"const": "source_intent_plain_data_digest_bound"},
    "mapping_contract": {
      "const": "source_to_intent_next_syntax.semantic_mapping.v0"
    },
    "parser_contract": {
      "const": "source_to_intent_research_parser.execution_free.v0"
    },
    "parser_output_policy": {"const": "source_intent.v0_plain_data_only"},
    "parser_rfc": {"const": "rfcs.0242_source_to_intent_next_syntax_slice"},
    "parser_status": {"const": "research_explicit_only"},
    "properties": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/property"},
      "uniqueItems": true
    },
    "property_count": {
      "type": "integer",
      "minimum": 6,
      "maximum": 6
    },
    "property_coverage_complete": {"const": true},
    "schema_version": {"const": "tuc.source_to_intent_next_syntax_report.v0"},
    "source_intent_contract": {"const": "source_intent_ir.canonical.v0"},
    "source_intent_schema_version": {"const": "source_intent.v0"},
    "syntax_slice": {"const": "phase_epsilon_branched_multi_return"},
    "triton_jit_execution": {"const": false}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "operation_count",
        "operation_families",
        "return_count",
        "source_bytes",
        "source_digest",
        "source_intent_payload_digest",
        "source_name",
        "syntax_features",
        "tensor_count"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/report_text"},
        "operation_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "operation_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "enum": ["elementwise", "matmul", "reduction", "softmax"]
          },
          "uniqueItems": true
        },
        "return_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "source_digest": {"$ref": "#/$defs/sha256_text"},
        "source_intent_payload_digest": {"$ref": "#/$defs/sha256_text"},
        "source_name": {"$ref": "#/$defs/report_text"},
        "syntax_features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "enum": [
              "branched_dataflow",
              "elementwise_where_to_source_intent",
              "explicit_public_return_aliases",
              "fanout_value_reuse",
              "matmul_to_source_intent",
              "multiple_terminal_stores",
              "reduction_explicit_axis_to_source_intent",
              "softmax_explicit_axis_to_source_intent"
            ]
          },
          "uniqueItems": true
        },
        "tensor_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "status"],
      "properties": {
        "property_id": {
          "enum": [
            "branched_dataflow_preserves_symbolic_dependencies",
            "direct_source_ingestion_remains_blocked",
            "multiple_stores_emit_explicit_public_returns",
            "nonterminal_return_mapping_fails_closed",
            "semantic_mapping_report_omits_raw_source",
            "source_intent_payload_validates_through_intake"
          ]
        },
        "status": {"const": "satisfied"}
      }
    },
    "report_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "not": {
        "enum": [
          "backend_artifact",
          "command_line",
          "device_id",
          "dynamic_library",
          "environment",
          "file_path",
          "generated_code",
          "host_path",
          "plugin_entrypoint",
          "python_source",
          "raw_source_text",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "url"
        ]
      }
    },
    "sha256_text": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
