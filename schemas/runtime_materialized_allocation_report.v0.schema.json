{
  "$id": "https://tuc.example/schemas/runtime_materialized_allocation_report.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocation_count": {"maximum": 4096, "minimum": 1, "type": "integer"},
    "allocation_execution_trace_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "allocation_mode": {"const": "in_process_preallocated_numpy_slots"},
    "allocations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address_exposure": {"const": "not_exposed"},
          "first_live_index": {"minimum": 0, "type": "integer"},
          "last_use_index": {"minimum": 0, "type": "integer"},
          "layout": {"const": "row_major"},
          "memory_domain": {"const": "host_ram"},
          "operation_index": {"minimum": 0, "type": "integer"},
          "operation_name": {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
          "planned_bytes": {"minimum": 1, "type": "integer"},
          "planned_dtype": {"const": "float32"},
          "previous_tensor_name": {
            "oneOf": [
              {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
              {"type": "null"}
            ]
          },
          "release_index": {"minimum": 0, "type": "integer"},
          "release_verification": {"const": "released_at_proven_last_use"},
          "reuse_status": {"enum": ["first_slot_generation", "reused_after_release"]},
          "runtime_bytes": {"minimum": 1, "type": "integer"},
          "runtime_dtype": {"const": "float64"},
          "shape": {"items": {"minimum": 1, "type": "integer"}, "maxItems": 8, "minItems": 1, "type": "array"},
          "slot_generation": {"minimum": 1, "type": "integer"},
          "slot_id": {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
          "status": {"const": "executed_and_verified"},
          "tensor_name": {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
          "write_verification": {"const": "exact_kernel_result"}
        },
        "required": [
          "address_exposure",
          "first_live_index",
          "last_use_index",
          "layout",
          "memory_domain",
          "operation_index",
          "operation_name",
          "planned_bytes",
          "planned_dtype",
          "previous_tensor_name",
          "release_index",
          "release_verification",
          "reuse_status",
          "runtime_bytes",
          "runtime_dtype",
          "shape",
          "slot_generation",
          "slot_id",
          "status",
          "tensor_name",
          "write_verification"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "allocator_contract": {"const": "runtime_allocator.trusted_simulator.v0"},
    "artifact_status": {"const": "review_evidence"},
    "blocked_execution_surfaces": {
      "items": false,
      "maxItems": 15,
      "minItems": 15,
      "prefixItems": [
        {"const": "backend_plugin_discovery"},
        {"const": "device_access"},
        {"const": "dynamic_import"},
        {"const": "dynamic_library_loading"},
        {"const": "generated_artifact_execution"},
        {"const": "jit_execution"},
        {"const": "network_access"},
        {"const": "subprocess_execution"},
        {"const": "allocator_plugin_loading"},
        {"const": "device_allocation"},
        {"const": "external_allocator_calls"},
        {"const": "memory_mapping"},
        {"const": "pointer_or_address_exposure"},
        {"const": "runtime_handle_serialization"},
        {"const": "unbounded_memory_pool"}
      ],
      "type": "array"
    },
    "budget_interpretation": {"const": "planned_float32_budget_separate_from_float64_executor_storage"},
    "evidence_contract": {"const": "runtime_allocation.materialized_trusted_simulator.v0"},
    "external_artifacts": {"const": "forbidden"},
    "graph_name": {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
    "handle_policy": {"const": "not_exposed"},
    "kernel_temporary_policy": {"const": "excluded_from_allocator_memory_claim"},
    "materialization_policy": {"const": "preallocate_write_release_reuse"},
    "materialization_scope": {"const": "trusted_host_ram_row_major_slots_only"},
    "native_allocator_claim": {"const": "not_claimed"},
    "operation_count": {"maximum": 4096, "minimum": 1, "type": "integer"},
    "output_metadata_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "performance_claim": {"const": "not_measured"},
    "physical_memory_claim": {"const": "host_process_storage_only"},
    "planned_reserved_bytes": {"minimum": 1, "type": "integer"},
    "raw_value_policy": {"const": "omitted_by_policy"},
    "reference_correctness_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "reference_correctness_passed": {"const": true},
    "release_count": {"maximum": 4096, "minimum": 1, "type": "integer"},
    "retained_tensor_record_count": {"minimum": 1, "type": "integer"},
    "retention_policy": {"const": "external_inputs_and_terminal_output_snapshots_only"},
    "reuse_event_count": {"maximum": 4095, "minimum": 1, "type": "integer"},
    "reused_slot_count": {"maximum": 256, "minimum": 1, "type": "integer"},
    "runtime_execution_trace_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "runtime_reserved_bytes": {"maximum": 134217728, "minimum": 1, "type": "integer"},
    "runtime_reuse_savings_bytes": {"minimum": 1, "type": "integer"},
    "runtime_unreused_tensor_bytes": {"minimum": 1, "type": "integer"},
    "schema_version": {"const": "tuc.runtime_materialized_allocation_report.v0"},
    "slot_count": {"maximum": 256, "minimum": 1, "type": "integer"},
    "slots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allocation_kind": {"enum": ["exclusive", "reused"]},
          "layout": {"const": "row_major"},
          "memory_domain": {"const": "host_ram"},
          "planned_bytes": {"minimum": 1, "type": "integer"},
          "planned_dtype": {"const": "float32"},
          "runtime_bytes": {"minimum": 1, "type": "integer"},
          "runtime_dtype": {"const": "float64"},
          "shape": {"items": {"minimum": 1, "type": "integer"}, "maxItems": 8, "minItems": 1, "type": "array"},
          "slot_id": {"maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "type": "string"},
          "status": {"const": "preallocated"},
          "tensor_count": {"minimum": 1, "type": "integer"}
        },
        "required": [
          "allocation_kind",
          "layout",
          "memory_domain",
          "planned_bytes",
          "planned_dtype",
          "runtime_bytes",
          "runtime_dtype",
          "shape",
          "slot_id",
          "status",
          "tensor_count"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "source_admission_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_allocation_plan_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_memory_budget_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_receipt_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_reconciliation_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "source_request_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "status": {"const": "passed"},
    "terminal_output_count": {"minimum": 1, "type": "integer"},
    "terminal_output_snapshot_bytes": {"minimum": 1, "type": "integer"},
    "write_mode": {"const": "trusted_kernel_result_copied_into_slot"}
  },
  "required": [
    "allocation_count",
    "allocation_execution_trace_digest",
    "allocation_mode",
    "allocations",
    "allocator_contract",
    "artifact_status",
    "blocked_execution_surfaces",
    "budget_interpretation",
    "evidence_contract",
    "external_artifacts",
    "graph_name",
    "handle_policy",
    "kernel_temporary_policy",
    "materialization_policy",
    "materialization_scope",
    "native_allocator_claim",
    "operation_count",
    "output_metadata_digest",
    "performance_claim",
    "physical_memory_claim",
    "planned_reserved_bytes",
    "raw_value_policy",
    "reference_correctness_digest",
    "reference_correctness_passed",
    "release_count",
    "retained_tensor_record_count",
    "retention_policy",
    "reuse_event_count",
    "reused_slot_count",
    "runtime_execution_trace_digest",
    "runtime_reserved_bytes",
    "runtime_reuse_savings_bytes",
    "runtime_unreused_tensor_bytes",
    "schema_version",
    "slot_count",
    "slots",
    "source_admission_digest",
    "source_allocation_plan_digest",
    "source_memory_budget_digest",
    "source_receipt_digest",
    "source_reconciliation_digest",
    "source_request_manifest_digest",
    "status",
    "terminal_output_count",
    "terminal_output_snapshot_bytes",
    "write_mode"
  ],
  "title": "TUC Runtime Materialized Allocation Report v0",
  "type": "object"
}
