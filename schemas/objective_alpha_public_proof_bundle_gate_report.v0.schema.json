{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/objective_alpha_public_proof_bundle_gate_report.v0.schema.json",
  "title": "TUC Objective Alpha Public Proof Bundle Gate Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kinds",
    "artifact_status",
    "blocked_claims",
    "blocked_execution_surfaces",
    "broad_source_parser_claim",
    "bundle_claim_status",
    "bundle_contract",
    "bundle_id",
    "bundle_metadata_digest",
    "bundle_raw_output_policy",
    "digest_policy",
    "entry_count",
    "entry_digest_count",
    "entry_points",
    "evidence_ids",
    "gate_contract",
    "gate_id",
    "gate_passed",
    "gate_status",
    "issues",
    "native_performance_claim",
    "required_invariants",
    "schema_version",
    "vendor_replacement_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "tuc.objective_alpha_public_proof_bundle_gate_report.v0"
    },
    "gate_id": {
      "const": "objective_alpha_public_proof_bundle_gate"
    },
    "gate_contract": {
      "const": "objective_alpha.public_proof_bundle_gate.data_only.v0"
    },
    "artifact_status": {
      "const": "review_evidence"
    },
    "gate_passed": {
      "const": true
    },
    "gate_status": {
      "const": "PASS"
    },
    "bundle_id": {
      "const": "objective_alpha_public_proof_bundle"
    },
    "bundle_contract": {
      "const": "objective_alpha.public_proof_bundle.v0"
    },
    "bundle_claim_status": {
      "const": "correctness_and_inspectability_only"
    },
    "bundle_raw_output_policy": {
      "const": "digest_only"
    },
    "digest_policy": {
      "const": "sha256_hex_only"
    },
    "bundle_metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry_count": {
      "const": 12
    },
    "entry_digest_count": {
      "const": 12
    },
    "native_performance_claim": {
      "const": false
    },
    "broad_source_parser_claim": {
      "const": false
    },
    "vendor_replacement_claim": {
      "const": false
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/report_text" }
    },
    "required_invariants": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "const": "fixed_evidence_ids" },
        { "const": "fixed_entry_points" },
        { "const": "fixed_artifact_kinds" },
        { "const": "passed_entries_only" },
        { "const": "digest_only_raw_output_policy" },
        { "const": "sha256_metadata_digests" },
        { "const": "blocked_native_performance_claim" },
        { "const": "blocked_vendor_replacement_claim" },
        { "const": "blocked_broad_source_parser_claim" }
      ]
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "native_performance_parity" },
        { "const": "vendor_compiler_replacement" },
        { "const": "broad_source_code_parsing" },
        { "const": "arbitrary_third_party_backend_execution" },
        { "const": "device_access" },
        { "const": "generated_artifact_execution" }
      ]
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "backend_plugin_discovery" },
        { "const": "device_access" },
        { "const": "dynamic_import" },
        { "const": "dynamic_library_loading" },
        { "const": "generated_artifact_execution" },
        { "const": "jit_execution" },
        { "const": "network_access" },
        { "const": "subprocess_execution" }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "const": "proof_of_execution" },
        { "const": "runtime_evidence_matrix" },
        { "const": "runtime_evidence_gate" },
        { "const": "proof_of_backend_equivalence" },
        { "const": "runtime_execution_output_closure" },
        { "const": "runtime_transfer_trace_replay_verifier" },
        { "const": "runtime_backend_equivalence_transfer_binding" },
        { "const": "runtime_layout_conversion_trace_replay_verifier" },
        { "const": "runtime_backend_equivalence_layout_binding" },
        { "const": "runtime_allocation_reconciliation" },
        { "const": "runtime_memory_planning_gate" },
        { "const": "research_onboarding_evidence" }
      ]
    },
    "entry_points": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "const": "python examples/proof_of_execution.py" },
        { "const": "python examples/runtime_evidence_matrix.py" },
        { "const": "python examples/runtime_evidence_gate.py" },
        { "const": "python examples/proof_of_backend_equivalence.py" },
        { "const": "python examples/runtime_execution_output_closure.py" },
        { "const": "python examples/runtime_transfer_trace_replay_verifier.py" },
        { "const": "python examples/runtime_backend_equivalence_transfer_binding.py" },
        { "const": "python examples/runtime_layout_conversion_trace_replay_verifier.py" },
        { "const": "python examples/runtime_backend_equivalence_layout_binding.py" },
        { "const": "python examples/runtime_allocation_reconciliation.py" },
        { "const": "python examples/runtime_memory_planning_gate.py" },
        { "const": "python examples/research_onboarding_evidence.py" }
      ]
    },
    "artifact_kinds": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        { "const": "deterministic_proof_output" },
        { "const": "schema_versioned_matrix_report" },
        { "const": "deterministic_gate_output" },
        { "const": "schema_versioned_backend_equivalence_proof_report" },
        { "const": "schema_versioned_output_closure_report" },
        { "const": "schema_versioned_transfer_trace_replay_verifier_report" },
        { "const": "schema_versioned_backend_equivalence_transfer_binding_report" },
        { "const": "schema_versioned_layout_conversion_trace_replay_verifier_report" },
        { "const": "schema_versioned_backend_equivalence_layout_binding_report" },
        { "const": "schema_versioned_allocation_reconciliation_report" },
        { "const": "deterministic_memory_planning_gate_output" },
        { "const": "schema_versioned_onboarding_report" }
      ]
    }
  },
  "$defs": {
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/ -]*$",
      "maxLength": 256,
      "not": {
        "enum": [
          "backend_artifact",
          "command_line",
          "device_id",
          "dynamic_library",
          "generated_code",
          "host_path",
          "plugin_entrypoint",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value"
        ]
      }
    }
  }
}