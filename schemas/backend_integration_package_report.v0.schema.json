{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/backend_integration_package_report.v0.schema.json",
  "title": "TUC Backend Integration Package Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_execution",
    "backend_code_executed",
    "backend_code_included",
    "backend_name",
    "blocked_execution_surfaces",
    "capability_manifest_digest",
    "case_count",
    "case_results",
    "conformance_passed",
    "declared_operation_families",
    "device_access",
    "execution_permission",
    "import_policy",
    "integration_contract",
    "integration_status",
    "issues",
    "memory_domain",
    "network_access",
    "package_digest",
    "package_id",
    "package_policy",
    "package_version",
    "planning_probe",
    "plugin_discovery",
    "produced_layouts",
    "runtime_execution",
    "schema_version",
    "subprocess_execution",
    "supported_layouts"
  ],
  "properties": {
    "schema_version": { "const": "tuc.backend_integration_package_report.v0" },
    "integration_contract": { "const": "backend_integration.data_only.v0" },
    "integration_status": { "enum": ["PASS", "FAIL"] },
    "package_id": { "$ref": "#/$defs/identifier" },
    "package_version": { "$ref": "#/$defs/identifier" },
    "package_policy": { "const": "capability_and_planning_conformance_only" },
    "import_policy": { "const": "no_import_or_plugin_discovery" },
    "package_digest": { "$ref": "#/$defs/digest" },
    "capability_manifest_digest": { "$ref": "#/$defs/digest" },
    "backend_name": { "$ref": "#/$defs/identifier" },
    "declared_operation_families": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["elementwise", "matmul", "reduction", "softmax"] }
    },
    "memory_domain": { "type": "string" },
    "supported_layouts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "produced_layouts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "case_count": { "type": "integer", "minimum": 1, "maximum": 32 },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/case_result" }
    },
    "planning_probe": { "$ref": "#/$defs/planning_probe" },
    "conformance_passed": { "type": "boolean" },
    "issues": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
    "blocked_execution_surfaces": {
      "const": [
        "backend_code_execution",
        "plugin_discovery",
        "dynamic_import",
        "dynamic_library_loading",
        "subprocess_execution",
        "network_access",
        "device_access",
        "generated_artifact_execution",
        "runtime_execution"
      ]
    },
    "backend_code_included": { "const": false },
    "execution_permission": { "const": false },
    "backend_code_executed": { "const": false },
    "plugin_discovery": { "const": false },
    "subprocess_execution": { "const": false },
    "network_access": { "const": false },
    "device_access": { "const": false },
    "artifact_execution": { "const": false },
    "runtime_execution": { "const": false }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_reason",
        "expected_supported",
        "layout",
        "matched",
        "observed_reason",
        "observed_supported",
        "operation_kind"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "expected_reason": { "type": "string" },
        "expected_supported": { "type": "boolean" },
        "layout": { "type": "string" },
        "matched": { "type": "boolean" },
        "observed_reason": { "type": "string" },
        "observed_supported": { "type": "boolean" },
        "operation_kind": { "type": "string" }
      }
    },
    "planning_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assigned_backend",
        "assignment_matched",
        "graph_name",
        "operation_kind",
        "operation_name"
      ],
      "properties": {
        "assigned_backend": { "$ref": "#/$defs/identifier" },
        "assignment_matched": { "type": "boolean" },
        "graph_name": { "$ref": "#/$defs/identifier" },
        "operation_kind": { "type": "string" },
        "operation_name": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
