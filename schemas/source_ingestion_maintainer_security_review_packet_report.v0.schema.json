{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_ingestion_maintainer_security_review_packet_report.v0.schema.json",
  "title": "TUC Source Ingestion Maintainer Security Review Packet v0",
  "description": "Digest-only maintainer-review packet for the future direct source ingestion slice. It is not an approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_effect",
    "approval_required",
    "approval_status",
    "artifact_policy",
    "blocked_execution_surfaces",
    "contract",
    "direct_source_ingestion",
    "evidence_id",
    "issues",
    "remaining_external_evidence",
    "remaining_external_evidence_count",
    "report_digest",
    "required_check_count",
    "required_checks",
    "review_evidence",
    "review_evidence_count",
    "schema_version",
    "source_ingestion_admission_ready",
    "source_to_compute_graph",
    "source_to_hac_ir",
    "source_to_runtime_plan",
    "status",
    "target_slice",
    "target_surface"
  ],
  "properties": {
    "schema_version": {"const": "tuc.source_ingestion_maintainer_security_review_packet_report.v0"},
    "evidence_id": {"const": "source_ingestion_maintainer_security_review_packet"},
    "contract": {"const": "source_ingestion_maintainer_security_review_packet.review.v0"},
    "status": {"const": "ready_for_maintainer_review"},
    "approval_status": {"const": "not_approved"},
    "approval_required": {"const": true},
    "target_surface": {"const": "direct_source_ingestion"},
    "target_slice": {"const": "bounded_source_buffer_to_source_intent_plain_data"},
    "artifact_policy": {"const": "digest_only_source_free"},
    "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
    "direct_source_ingestion": {"const": false},
    "source_ingestion_admission_ready": {"const": false},
    "source_to_compute_graph": {"const": false},
    "source_to_hac_ir": {"const": false},
    "source_to_runtime_plan": {"const": false},
    "remaining_external_evidence_count": {"const": 1},
    "required_check_count": {"const": 14},
    "review_evidence_count": {"const": 8},
    "report_digest": {"$ref": "#/$defs/sha256_text"},
    "issues": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "remaining_external_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"const": "maintainer_security_review_approval"}
      ],
      "items": false
    },
    "required_checks": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "prefixItems": [
        {"const": "bounded_source_buffer_reviewed"},
        {"const": "sandbox_boundary_reviewed"},
        {"const": "negative_corpus_reviewed"},
        {"const": "source_free_diagnostics_reviewed"},
        {"const": "plain_data_golden_reviewed"},
        {"const": "ci_replay_reviewed"},
        {"const": "first_slice_plan_reviewed"},
        {"const": "no_raw_source_serialization"},
        {"const": "no_source_intent_payload_serialization"},
        {"const": "no_runtime_handle_serialization"},
        {"const": "no_host_path_serialization"},
        {"const": "no_command_serialization"},
        {"const": "direct_source_ingestion_remains_blocked"},
        {"const": "maintainer_approval_required"}
      ],
      "items": false
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "frontend_package_import"},
        {"const": "plugin_discovery"},
        {"const": "triton_jit_execution"},
        {"const": "device_access"},
        {"const": "generated_artifact_execution"},
        {"const": "native_backend_execution"},
        {"const": "python_import"},
        {"const": "network_access"},
        {"const": "subprocess_execution"},
        {"const": "dynamic_library_loading"}
      ],
      "items": false
    },
    "review_evidence": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/admitting_source_ingestion_rfc_review"},
        {"$ref": "#/$defs/bounded_source_buffer_api_review"},
        {"$ref": "#/$defs/source_ingestion_sandbox_review"},
        {"$ref": "#/$defs/parser_fuzz_negative_corpus_review"},
        {"$ref": "#/$defs/source_free_diagnostics_review"},
        {"$ref": "#/$defs/source_to_intent_plain_data_golden_review"},
        {"$ref": "#/$defs/ci_replay_for_admitted_slice_review"},
        {"$ref": "#/$defs/real_triton_first_slice_plan_review"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256_text": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "review_item_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "digest",
        "evidence_id",
        "reviewable",
        "source_free",
        "status"
      ],
      "properties": {
        "contract": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "digest": {"$ref": "#/$defs/sha256_text"},
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "reviewable": {"const": true},
        "source_free": {"const": true},
        "status": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}
      }
    },
    "admitting_source_ingestion_rfc_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "admitting_source_ingestion_rfc.data_only.v0"},
            "evidence_id": {"const": "admitting_source_ingestion_rfc"},
            "status": {"const": "accepted_requirements_only"}
          }
        }
      ]
    },
    "bounded_source_buffer_api_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "bounded_source_buffer_api.execution_free.v0"},
            "evidence_id": {"const": "bounded_source_buffer_api"},
            "status": {"const": "implemented_non_admitting"}
          }
        }
      ]
    },
    "source_ingestion_sandbox_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "source_ingestion_sandbox_implementation.execution_free.v0"},
            "evidence_id": {"const": "source_ingestion_sandbox_implementation"},
            "status": {"const": "implemented_non_admitting"}
          }
        }
      ]
    },
    "parser_fuzz_negative_corpus_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "parser_fuzz_negative_corpus_for_admitting_slice.data_only.v0"},
            "evidence_id": {"const": "parser_fuzz_negative_corpus_for_admitting_slice"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    },
    "source_free_diagnostics_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "source_free_diagnostics_admission_tests.data_only.v0"},
            "evidence_id": {"const": "source_free_diagnostics_admission_tests"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    },
    "source_to_intent_plain_data_golden_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "source_to_intent_plain_data_output_golden_for_admitted_slice.data_only.v0"},
            "evidence_id": {"const": "source_to_intent_plain_data_output_golden_for_admitted_slice"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    },
    "ci_replay_for_admitted_slice_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "ci_replay_for_admitted_slice.ci.v0"},
            "evidence_id": {"const": "ci_replay_for_admitted_slice"},
            "status": {"const": "PASS"}
          }
        }
      ]
    },
    "real_triton_first_slice_plan_review": {
      "allOf": [
        {"$ref": "#/$defs/review_item_base"},
        {
          "properties": {
            "contract": {"const": "real_triton_first_slice_plan.data_only.v0"},
            "evidence_id": {"const": "real_triton_first_admissible_slice_plan"},
            "status": {"const": "blocked_until_admitting_source_ingestion_evidence"}
          }
        }
      ]
    }
  }
}
