{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_ingestion_sandbox_implementation_report.v0.schema.json",
  "title": "TUC Source Ingestion Sandbox Implementation Report v0",
  "description": "Source-free evidence that the source-ingestion sandbox implementation wraps the bounded source-buffer API without admitting direct source ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_case_count",
    "accepted_results",
    "admission_effect",
    "artifact_policy",
    "blocked_execution_surfaces",
    "blocked_outputs",
    "bounded_source_buffer_api_evidence",
    "diagnostic_policy",
    "direct_source_ingestion",
    "evidence_id",
    "issues",
    "output_policy",
    "raw_source_policy",
    "rejection_case_count",
    "rejection_results",
    "report_digest",
    "required_control_count",
    "required_controls",
    "sandbox_contract",
    "sandbox_status",
    "schema_version",
    "source_to_compute_graph",
    "source_to_hac_ir",
    "source_to_intent_plain_data",
    "source_to_runtime_plan"
  ],
  "properties": {
    "schema_version": {"const": "tuc.source_ingestion_sandbox_implementation_report.v0"},
    "sandbox_contract": {"const": "source_ingestion_sandbox_implementation.execution_free.v0"},
    "evidence_id": {"const": "source_ingestion_sandbox_implementation"},
    "sandbox_status": {"const": "implemented_non_admitting"},
    "artifact_policy": {"const": "metadata_only_source_free"},
    "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
    "output_policy": {"const": "bounded_source_buffer_record_only"},
    "raw_source_policy": {"const": "omitted_by_policy"},
    "diagnostic_policy": {"const": "source_free_reason_codes_only"},
    "direct_source_ingestion": {"const": false},
    "source_to_compute_graph": {"const": false},
    "source_to_hac_ir": {"const": false},
    "source_to_intent_plain_data": {"const": false},
    "source_to_runtime_plan": {"const": false},
    "accepted_case_count": {"const": 2},
    "rejection_case_count": {"const": 4},
    "required_control_count": {"const": 15},
    "report_digest": {"$ref": "#/$defs/sha256_text"},
    "issues": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "bounded_source_buffer_api_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "digest",
        "evidence_id",
        "source_free",
        "status",
        "supports_sandbox"
      ],
      "properties": {
        "contract": {"const": "bounded_source_buffer_api.execution_free.v0"},
        "digest": {"$ref": "#/$defs/sha256_text"},
        "evidence_id": {"const": "bounded_source_buffer_api"},
        "source_free": {"const": true},
        "status": {"const": "implemented_non_admitting"},
        "supports_sandbox": {"const": true}
      }
    },
    "accepted_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/accepted_result"}
    },
    "rejection_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/rejection_result"}
    },
    "required_controls": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        {"const": "bounded_source_buffer_api"},
        {"const": "decode_only_before_validation"},
        {"const": "fail_closed_before_lowering"},
        {"const": "source_free_diagnostics"},
        {"const": "source_digest_only"},
        {"const": "no_python_import"},
        {"const": "no_triton_jit"},
        {"const": "no_decorator_evaluation"},
        {"const": "no_device_access"},
        {"const": "no_generated_artifacts"},
        {"const": "no_native_backend_execution"},
        {"const": "no_source_to_intent_output"},
        {"const": "no_source_to_compute_graph"},
        {"const": "no_source_to_hac_ir"},
        {"const": "no_source_to_runtime_plan"}
      ],
      "items": false
    },
    "blocked_outputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"const": "backend_artifact"},
        {"const": "compute_graph"},
        {"const": "generated_artifact"},
        {"const": "hac_ir"},
        {"const": "hs_ir"},
        {"const": "python_function_object"},
        {"const": "runtime_plan"},
        {"const": "source_intent_plain_data"},
        {"const": "tlir"}
      ],
      "items": false
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {"const": "decorator_evaluation"},
        {"const": "device_access"},
        {"const": "dynamic_library_loading"},
        {"const": "frontend_package_import"},
        {"const": "generated_artifact_execution"},
        {"const": "native_backend_execution"},
        {"const": "network_access"},
        {"const": "plugin_discovery"},
        {"const": "python_import"},
        {"const": "subprocess_execution"},
        {"const": "triton_jit_execution"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256_text": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "report_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "accepted_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_effect",
        "ast_depth",
        "ast_node_count",
        "blocked_execution_surfaces",
        "blocked_outputs",
        "bounded_source_buffer_api_contract",
        "bounded_source_buffer_api_status",
        "bounded_source_buffer_record_digest",
        "diagnostic_policy",
        "direct_source_ingestion",
        "line_count",
        "outcome",
        "output_policy",
        "raw_source_policy",
        "reason_code",
        "sandbox_contract",
        "sandbox_status",
        "shape_profile_digest",
        "shape_profile_entry_count",
        "shape_profile_max_rank",
        "source_bytes",
        "source_digest",
        "source_name",
        "source_to_compute_graph",
        "source_to_hac_ir",
        "source_to_intent_plain_data",
        "source_to_runtime_plan"
      ],
      "properties": {
        "source_name": {"$ref": "#/$defs/report_text"},
        "source_digest": {"$ref": "#/$defs/sha256_text"},
        "source_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "line_count": {"type": "integer", "minimum": 1, "maximum": 2048},
        "ast_node_count": {"type": "integer", "minimum": 1, "maximum": 8192},
        "ast_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "shape_profile_digest": {"$ref": "#/$defs/sha256_text"},
        "shape_profile_entry_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "shape_profile_max_rank": {"type": "integer", "minimum": 1, "maximum": 8},
        "bounded_source_buffer_record_digest": {"$ref": "#/$defs/sha256_text"},
        "bounded_source_buffer_api_contract": {"const": "bounded_source_buffer_api.execution_free.v0"},
        "bounded_source_buffer_api_status": {"const": "implemented_non_admitting"},
        "sandbox_contract": {"const": "source_ingestion_sandbox_implementation.execution_free.v0"},
        "sandbox_status": {"const": "implemented_non_admitting"},
        "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
        "output_policy": {"const": "bounded_source_buffer_record_only"},
        "raw_source_policy": {"const": "omitted_by_policy"},
        "diagnostic_policy": {"const": "source_free_reason_codes_only"},
        "blocked_outputs": {"$ref": "#/properties/blocked_outputs"},
        "blocked_execution_surfaces": {"$ref": "#/properties/blocked_execution_surfaces"},
        "direct_source_ingestion": {"const": false},
        "source_to_compute_graph": {"const": false},
        "source_to_hac_ir": {"const": false},
        "source_to_intent_plain_data": {"const": false},
        "source_to_runtime_plan": {"const": false},
        "outcome": {"const": "accepted_metadata_only"},
        "reason_code": {"const": "accepted_metadata_only"}
      }
    },
    "rejection_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_effect",
        "blocked_execution_surfaces",
        "blocked_outputs",
        "diagnostic_policy",
        "direct_source_ingestion",
        "outcome",
        "output_policy",
        "raw_source_policy",
        "reason_code",
        "sandbox_contract",
        "sandbox_status",
        "source_digest",
        "source_free",
        "source_name",
        "source_to_compute_graph",
        "source_to_hac_ir",
        "source_to_intent_plain_data",
        "source_to_runtime_plan"
      ],
      "properties": {
        "source_name": {"$ref": "#/$defs/report_text"},
        "source_digest": {"$ref": "#/$defs/sha256_text"},
        "sandbox_contract": {"const": "source_ingestion_sandbox_implementation.execution_free.v0"},
        "sandbox_status": {"const": "implemented_non_admitting"},
        "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
        "output_policy": {"const": "bounded_source_buffer_record_only"},
        "raw_source_policy": {"const": "omitted_by_policy"},
        "diagnostic_policy": {"const": "source_free_reason_codes_only"},
        "blocked_outputs": {"$ref": "#/properties/blocked_outputs"},
        "blocked_execution_surfaces": {"$ref": "#/properties/blocked_execution_surfaces"},
        "direct_source_ingestion": {"const": false},
        "source_to_compute_graph": {"const": false},
        "source_to_hac_ir": {"const": false},
        "source_to_intent_plain_data": {"const": false},
        "source_to_runtime_plan": {"const": false},
        "outcome": {"const": "rejected"},
        "reason_code": {
          "enum": [
            "empty_source",
            "byte_budget",
            "line_budget",
            "syntax_error",
            "shape_profile",
            "report_safe",
            "type_error",
            "other_rejected"
          ]
        },
        "source_free": {"const": true}
      }
    }
  }
}