{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/objective_alpha_public_evidence_catalog_admission_gate_report.v0.schema.json",
  "title": "TUC Objective Alpha Public Evidence Catalog Admission Gate Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_status",
    "blocked_changes",
    "blocked_claims",
    "blocked_execution_surfaces",
    "catalog_artifact_kinds",
    "catalog_contract",
    "catalog_digest_policy",
    "catalog_entry_capacity",
    "catalog_entry_count",
    "catalog_entry_digest_count",
    "catalog_entry_points",
    "catalog_evidence_ids",
    "catalog_extension_tiers",
    "catalog_growth_policy",
    "catalog_id",
    "catalog_metadata_digest",
    "catalog_raw_output_policies",
    "catalog_scope",
    "digest_policy",
    "extension_policy_contract",
    "extension_policy_metadata_digest",
    "gate_contract",
    "gate_id",
    "gate_passed",
    "gate_status",
    "issues",
    "required_controls",
    "required_invariants",
    "runtime_backend_equivalence_portfolio_metadata_digest",
    "source_to_intent_research_kernel_ingress_proof_bundle_metadata_digest",
    "schema_version",
    "stable_entry_capacity",
    "stable_entry_count",
    "stable_entrypoint"
  ],
  "properties": {
    "schema_version": {
      "const": "tuc.objective_alpha_public_evidence_catalog_admission_gate_report.v0"
    },
    "gate_id": {
      "const": "objective_alpha_public_evidence_catalog_admission_gate"
    },
    "gate_contract": {
      "const": "objective_alpha.public_evidence_catalog_admission_gate.data_only.v0"
    },
    "artifact_status": {
      "const": "review_gate"
    },
    "gate_passed": {
      "const": true
    },
    "gate_status": {
      "const": "PASS"
    },
    "digest_policy": {
      "const": "sha256_hex_only"
    },
    "catalog_id": {
      "const": "objective_alpha_public_evidence_catalog"
    },
    "catalog_contract": {
      "const": "objective_alpha.public_evidence_catalog.data_only.v0"
    },
    "catalog_scope": {
      "const": "objective_alpha_extensions_after_public_bundle_capacity"
    },
    "catalog_growth_policy": {
      "const": "append_only_rfc_bound"
    },
    "catalog_digest_policy": {
      "const": "sha256_hex_only"
    },
    "catalog_metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stable_entrypoint": {
      "const": "objective_alpha_public_proof_bundle"
    },
    "stable_entry_capacity": {
      "const": 16
    },
    "stable_entry_count": {
      "const": 16
    },
    "extension_policy_contract": {
      "const": "objective_alpha.evidence_extension_policy.data_only.v0"
    },
    "extension_policy_metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_backend_equivalence_portfolio_metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_to_intent_research_kernel_ingress_proof_bundle_metadata_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalog_entry_capacity": {
      "const": 32
    },
    "catalog_entry_count": {
      "const": 3
    },
    "catalog_entry_digest_count": {
      "const": 3
    },
    "catalog_evidence_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "objective_alpha_evidence_extension_policy" },
        { "const": "runtime_backend_equivalence_portfolio" },
        { "const": "source_to_intent_research_kernel_ingress_proof_bundle" }
      ]
    },
    "catalog_entry_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "python examples/objective_alpha_evidence_extension_policy.py" },
        { "const": "python examples/runtime_backend_equivalence_portfolio.py" },
        { "const": "python examples/source_to_intent_research_kernel_ingress_proof_bundle.py" }
      ]
    },
    "catalog_artifact_kinds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "schema_versioned_extension_policy_report" },
        { "const": "schema_versioned_backend_equivalence_portfolio_report" },
        { "const": "schema_versioned_source_to_intent_kernel_ingress_proof_bundle_report" }
      ]
    },
    "catalog_extension_tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "governance" },
        { "const": "runtime_proof" },
        { "const": "frontend_runtime_proof" }
      ]
    },
    "catalog_raw_output_policies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "digest_only" },
        { "const": "digest_only" },
        { "const": "digest_only" }
      ]
    },
    "required_invariants": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        { "const": "catalog_report_passed" },
        { "const": "catalog_metadata_digest_bound" },
        { "const": "stable_public_bundle_anchor" },
        { "const": "stable_public_bundle_full" },
        { "const": "extension_policy_contract_bound" },
        { "const": "extension_policy_digest_entry_bound" },
        { "const": "backend_equivalence_portfolio_digest_entry_bound" },
        { "const": "first_non_governance_runtime_proof_entry_bound" },
        { "const": "kernel_ingress_proof_bundle_digest_entry_bound" },
        { "const": "fixed_initial_catalog_entries" },
        { "const": "append_only_rfc_bound_growth_policy" },
        { "const": "digest_only_catalog_entries" },
        { "const": "source_free_public_reports" },
        { "const": "blocked_claims_preserved" },
        { "const": "blocked_execution_surfaces_preserved" }
      ]
    },
    "required_controls": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "schema_versioned_extension_artifacts" },
        { "const": "sha256_metadata_digests" },
        { "const": "source_free_public_reports" },
        { "const": "digest_only_public_links" },
        { "const": "no_execution_handles" },
        { "const": "no_device_access" },
        { "const": "no_generated_artifact_execution" },
        { "const": "no_native_performance_claim" }
      ]
    },
    "blocked_changes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "increase_public_bundle_capacity_without_rfc" },
        { "const": "replace_public_bundle_entries_without_rfc" },
        { "const": "add_source_buffers_to_public_artifacts" },
        { "const": "add_tensor_values_to_public_artifacts" },
        { "const": "authorize_execution_handles" },
        { "const": "authorize_device_access" },
        { "const": "authorize_generated_artifact_execution" },
        { "const": "claim_native_performance" }
      ]
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "native_performance_parity" },
        { "const": "vendor_compiler_replacement" },
        { "const": "broad_source_code_parsing" },
        { "const": "arbitrary_third_party_backend_execution" },
        { "const": "device_access" },
        { "const": "generated_artifact_execution" }
      ]
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "backend_plugin_discovery" },
        { "const": "device_access" },
        { "const": "dynamic_import" },
        { "const": "dynamic_library_loading" },
        { "const": "generated_artifact_execution" },
        { "const": "jit_execution" },
        { "const": "network_access" },
        { "const": "subprocess_execution" }
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/report_text" }
    }
  },
  "$defs": {
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/ -]*$",
      "maxLength": 256,
      "not": {
        "enum": [
          "backend_artifact",
          "command_line",
          "device_id",
          "dynamic_library",
          "generated_code",
          "host_path",
          "plugin_entrypoint",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value"
        ]
      }
    }
  }
}