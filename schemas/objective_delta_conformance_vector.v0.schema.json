{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/objective_delta_conformance_vector.v0.schema.json",
  "title": "TUC Objective Delta Conformance Vector v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "dtype",
    "elementwise_semantics",
    "expected_public_outputs",
    "inputs",
    "schema_version"
  ],
  "properties": {
    "contract": { "const": "objective_delta.fixed_semantics.v0" },
    "dtype": { "const": "float64" },
    "elementwise_semantics": { "const": "identity" },
    "expected_public_outputs": {
      "const": {
        "api_activated": [
          [4.0, 0.5],
          [-2.0, 1.25]
        ]
      }
    },
    "inputs": {
      "const": {
        "lhs": [
          [1.0, -2.0],
          [0.5, 3.0]
        ],
        "rhs": [
          [2.0, 1.0],
          [-1.0, 0.25]
        ]
      }
    },
    "schema_version": {
      "const": "tuc.objective_delta_conformance_vector.v0"
    }
  }
}
