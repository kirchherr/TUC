{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuc.dev/schemas/source_to_intent_research_kernel_ingress_e2e_report.v0.schema.json",
  "title": "TUC Source-To-Intent Research Kernel Ingress E2E Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_policy",
    "blocked_claims",
    "case_count",
    "cases",
    "default_parser_status",
    "e2e_contract",
    "frontend_ingress_contract",
    "input_policy",
    "output_policy",
    "parser_output_policy",
    "parser_status",
    "raw_source_policy",
    "raw_value_policy",
    "schema_version",
    "source_boundary",
    "status"
  ],
  "properties": {
    "artifact_policy": {
      "const": "metadata_only_values_omitted"
    },
    "blocked_claims": {
      "type": "array",
      "prefixItems": [
        {
          "const": "general_triton_source_ingestion"
        },
        {
          "const": "native_performance_claim"
        },
        {
          "const": "production_parser"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "case_count": {
      "const": 4
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "default_parser_status": {
      "const": "default_parser_blocked"
    },
    "e2e_contract": {
      "const": "source_to_intent_research_kernel_ingress.e2e.v0"
    },
    "frontend_ingress_contract": {
      "const": "source_to_intent_research_kernel_ingress.execution_free.v0"
    },
    "input_policy": {
      "const": "single_triton_module_source_buffer_only"
    },
    "output_policy": {
      "const": "extracted_kernel_source_to_source_intent.v0_plain_data"
    },
    "parser_output_policy": {
      "const": "source_intent.v0_plain_data_only"
    },
    "parser_status": {
      "const": "research_explicit_only"
    },
    "raw_source_policy": {
      "const": "omitted_by_policy"
    },
    "raw_value_policy": {
      "const": "omitted_by_policy"
    },
    "schema_version": {
      "const": "tuc.source_to_intent_research_kernel_ingress_e2e_report.v0"
    },
    "source_boundary": {
      "const": "triton_module_source_buffer_to_runtime_via_research_kernel_ingress"
    },
    "status": {
      "const": "PASS"
    }
  },
  "$defs": {
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_sequence",
        "case_id",
        "compiler_decision_digest",
        "execution_trace_digest",
        "extracted_kernel_digest",
        "hac_ir_digest",
        "ingress_report_digest",
        "kernel_name",
        "metadata_intake_digest",
        "metadata_report_digest",
        "module_digest",
        "operation_families",
        "parser_report_digest",
        "plain_data_digest",
        "readiness_digest",
        "reference_correctness_digest",
        "runtime_plan_digest",
        "source_intent_digest",
        "terminal_outputs",
        "trace_step_count"
      ],
      "properties": {
        "backend_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "case_id": {
          "enum": [
            "research_module_matmul_elementwise",
            "research_module_softmax_reduction",
            "research_module_matmul_reduction",
            "research_module_mvp_pipeline"
          ]
        },
        "compiler_decision_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "execution_trace_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "extracted_kernel_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "hac_ir_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "ingress_report_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "kernel_name": {
          "enum": [
            "matmul_elementwise",
            "softmax_reduction",
            "matmul_reduction",
            "mvp_pipeline"
          ]
        },
        "metadata_intake_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "metadata_report_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "module_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "operation_families": {
          "type": "array",
          "items": {
            "enum": [
              "elementwise",
              "matmul",
              "reduction",
              "softmax"
            ]
          },
          "minItems": 2,
          "maxItems": 4
        },
        "parser_report_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "plain_data_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "readiness_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "reference_correctness_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "runtime_plan_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "source_intent_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "terminal_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "trace_step_count": {
          "enum": [2, 4]
        }
      }
    }
  }
}
