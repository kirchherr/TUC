{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/bounded_cpu_batch.v0.schema.json",
  "title": "Bounded CPU batch inputs v0",
  "description": "Structural contract; the TUC adapter additionally enforces unique request IDs, disjoint shared inputs, exact graph bindings, FP32 values and aggregate budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": "tuc.bounded_cpu_batch.v0"},
    "shared_inputs": {"$ref": "#/$defs/inputs"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
          "inputs": {"$ref": "#/$defs/inputs"}
        }
      }
    }
  },
  "$defs": {
    "inputs": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {"minLength": 1, "maxLength": 64},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": {"type": "number"}
      }
    }
  }
}
