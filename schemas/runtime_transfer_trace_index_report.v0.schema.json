{
  "$id": "https://tuc.dev/schemas/runtime_transfer_trace_index_report.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_status": {"const": "review_evidence"},
    "blocked_execution_surfaces": {
      "items": false,
      "maxItems": 8,
      "minItems": 8,
      "prefixItems": [
        {"const": "backend_plugin_discovery"},
        {"const": "device_access"},
        {"const": "dynamic_import"},
        {"const": "dynamic_library_loading"},
        {"const": "generated_artifact_execution"},
        {"const": "jit_execution"},
        {"const": "network_access"},
        {"const": "subprocess_execution"}
      ],
      "type": "array"
    },
    "cost_claim_status": {"const": "planning_estimate_not_measurement"},
    "execution_policy": {"const": "does_not_execute_transfers"},
    "execution_trace_digest": {"$ref": "#/$defs/digest"},
    "executor_contract": {"const": "runtime_executor.trusted_backend.v0"},
    "graph_name": {"$ref": "#/$defs/report_text"},
    "issues": {
      "items": {"$ref": "#/$defs/issue"},
      "maxItems": 256,
      "type": "array"
    },
    "passed": {"type": "boolean"},
    "raw_value_policy": {"const": "omitted_by_policy"},
    "records": {
      "items": {"$ref": "#/$defs/record"},
      "maxItems": 4096,
      "type": "array"
    },
    "residency_claim_status": {"const": "not_physical_residency_evidence"},
    "schema_version": {"const": "tuc.runtime_transfer_trace_index_report.v0"},
    "source_evidence_contract": {"const": "runtime_transfer_evidence.data_only.v0"},
    "source_partition_plan_digest": {"$ref": "#/$defs/digest"},
    "source_transfer_evidence_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "PASS"},
    "total_estimated_energy_pj": {"minimum": 0, "type": "number"},
    "total_estimated_latency_ns": {"minimum": 0, "type": "number"},
    "total_planned_bytes": {"minimum": 0, "type": "integer"},
    "trace_index_contract": {"const": "runtime_transfer_trace_index.data_only.v0"},
    "trace_index_scope": {"const": "planned_transfer_trace_alignment_only"},
    "trace_materialization_policy": {"const": "transfer_not_materialized_as_runtime_step"},
    "trace_step_count": {"minimum": 1, "type": "integer"},
    "transfer_count": {"minimum": 0, "type": "integer"},
    "transfer_scope": {"const": "planned_logical_transfer_only"},
    "trusted_executor_registry": {"const": "trusted_runtime_executor_registry.v0"}
  },
  "required": [
    "artifact_status",
    "blocked_execution_surfaces",
    "cost_claim_status",
    "execution_policy",
    "execution_trace_digest",
    "executor_contract",
    "graph_name",
    "issues",
    "passed",
    "raw_value_policy",
    "records",
    "residency_claim_status",
    "schema_version",
    "source_evidence_contract",
    "source_partition_plan_digest",
    "source_transfer_evidence_digest",
    "status",
    "total_estimated_energy_pj",
    "total_estimated_latency_ns",
    "total_planned_bytes",
    "trace_index_contract",
    "trace_index_scope",
    "trace_materialization_policy",
    "trace_step_count",
    "transfer_count",
    "transfer_scope",
    "trusted_executor_registry"
  ],
  "type": "object",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "issue": {
      "additionalProperties": false,
      "properties": {
        "issue_code": {"$ref": "#/$defs/report_text"},
        "subject": {"$ref": "#/$defs/report_text"}
      },
      "required": ["issue_code", "subject"],
      "type": "object"
    },
    "layout": {
      "enum": ["row_major", "column_major", "blocked", "vector", "unknown"],
      "type": "string"
    },
    "memory_domain": {
      "enum": [
        "host_ram",
        "gpu_hbm",
        "device_sram",
        "analog_weight_bank",
        "neuromorphic_synapse_array",
        "persistent_nvm",
        "stream_buffer",
        "unknown"
      ],
      "type": "string"
    },
    "operation_kind": {
      "enum": ["elementwise", "matmul", "reduction", "softmax"],
      "type": "string"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "consumer_executor_backend": {"$ref": "#/$defs/report_text"},
        "consumer_input_id": {"$ref": "#/$defs/report_text"},
        "consumer_input_tensors": {
          "items": {"$ref": "#/$defs/report_text"},
          "minItems": 1,
          "type": "array"
        },
        "consumer_operation": {"$ref": "#/$defs/report_text"},
        "consumer_operation_kind": {"$ref": "#/$defs/operation_kind"},
        "consumer_planned_backend": {"$ref": "#/$defs/report_text"},
        "consumer_step_index": {"minimum": 0, "type": "integer"},
        "cost_model": {"const": "prototype_transfer_cost_profile"},
        "estimated_energy_pj": {"minimum": 0, "type": "number"},
        "estimated_latency_ns": {"minimum": 0, "type": "number"},
        "from_layout": {"$ref": "#/$defs/layout"},
        "from_memory_domain": {"$ref": "#/$defs/memory_domain"},
        "planned_bytes": {"minimum": 1, "type": "integer"},
        "producer_executor_backend": {"$ref": "#/$defs/report_text"},
        "producer_operation": {"$ref": "#/$defs/report_text"},
        "producer_operation_kind": {"$ref": "#/$defs/operation_kind"},
        "producer_output_tensors": {
          "items": {"$ref": "#/$defs/report_text"},
          "minItems": 1,
          "type": "array"
        },
        "producer_planned_backend": {"$ref": "#/$defs/report_text"},
        "producer_step_index": {"minimum": 0, "type": "integer"},
        "source_transfer_status": {"const": "planned"},
        "source_value_record_id": {"$ref": "#/$defs/report_text"},
        "tensor_name": {"$ref": "#/$defs/report_text"},
        "to_layout": {"$ref": "#/$defs/layout"},
        "to_memory_domain": {"$ref": "#/$defs/memory_domain"},
        "trace_alignment_status": {"const": "producer_before_consumer"},
        "trace_record_status": {"const": "planned_not_executed"},
        "transfer_id": {"$ref": "#/$defs/report_text"}
      },
      "required": [
        "consumer_executor_backend",
        "consumer_input_id",
        "consumer_input_tensors",
        "consumer_operation",
        "consumer_operation_kind",
        "consumer_planned_backend",
        "consumer_step_index",
        "cost_model",
        "estimated_energy_pj",
        "estimated_latency_ns",
        "from_layout",
        "from_memory_domain",
        "planned_bytes",
        "producer_executor_backend",
        "producer_operation",
        "producer_operation_kind",
        "producer_output_tensors",
        "producer_planned_backend",
        "producer_step_index",
        "source_transfer_status",
        "source_value_record_id",
        "tensor_name",
        "to_layout",
        "to_memory_domain",
        "trace_alignment_status",
        "trace_record_status",
        "transfer_id"
      ],
      "type": "object"
    },
    "report_text": {
      "maxLength": 512,
      "not": {
        "enum": [
          "allocation_handle",
          "backend_artifact",
          "callable",
          "command",
          "device_id",
          "device_pointer",
          "dynamic_library",
          "env",
          "environment",
          "executable",
          "file_path",
          "generated_code",
          "host_path",
          "import_module",
          "jit_function",
          "memory_address",
          "module",
          "network",
          "plugin_entrypoint",
          "pointer",
          "python_module",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value",
          "url"
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    }
  }
}
