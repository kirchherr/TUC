{
  "$id": "https://tuc.dev/schemas/runtime_layout_conversion_gate_readiness_report.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_status": {
      "const": "review_evidence"
    },
    "blocked_execution_surfaces": {
      "items": false,
      "maxItems": 8,
      "minItems": 8,
      "prefixItems": [
        {
          "const": "backend_plugin_discovery"
        },
        {
          "const": "device_access"
        },
        {
          "const": "dynamic_import"
        },
        {
          "const": "dynamic_library_loading"
        },
        {
          "const": "generated_artifact_execution"
        },
        {
          "const": "jit_execution"
        },
        {
          "const": "network_access"
        },
        {
          "const": "subprocess_execution"
        }
      ],
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/check"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/issue"
      },
      "maxItems": 7,
      "type": "array"
    },
    "proposal_name": {
      "$ref": "#/$defs/report_text"
    },
    "readiness_contract": {
      "const": "runtime_layout_conversion_gate_readiness.data_only.v0"
    },
    "readiness_metadata_digest": {
      "$ref": "#/$defs/digest"
    },
    "readiness_status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "tuc.runtime_layout_conversion_gate_readiness_report.v0"
    },
    "source_conversion_count": {
      "minimum": 0,
      "type": "integer"
    },
    "source_conversion_metadata_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_evidence_contract": {
      "const": "runtime_layout_conversion_evidence.data_only.v0"
    },
    "source_evidence_issue_count": {
      "minimum": 0,
      "type": "integer"
    },
    "source_evidence_schema_version": {
      "const": "tuc.runtime_layout_conversion_evidence_report.v0"
    },
    "source_graph_name": {
      "$ref": "#/$defs/report_text"
    },
    "source_partition_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "target_artifact_id": {
      "const": "runtime_layout_conversion_evidence_mixed"
    },
    "target_artifact_kind": {
      "const": "runtime_layout_conversion_evidence"
    },
    "target_gate_status": {
      "const": "optional_matrix_inventory_not_gate_required"
    },
    "target_graph_id": {
      "const": "runtime_mixed_backend_equivalence"
    }
  },
  "required": [
    "artifact_status",
    "blocked_execution_surfaces",
    "checks",
    "issues",
    "proposal_name",
    "readiness_contract",
    "readiness_metadata_digest",
    "readiness_status",
    "ready",
    "schema_version",
    "source_conversion_count",
    "source_conversion_metadata_digest",
    "source_evidence_contract",
    "source_evidence_issue_count",
    "source_evidence_schema_version",
    "source_graph_name",
    "source_partition_plan_digest",
    "target_artifact_id",
    "target_artifact_kind",
    "target_gate_status",
    "target_graph_id"
  ],
  "type": "object",
  "$defs": {
    "check": {
      "additionalProperties": false,
      "properties": {
        "check_name": {
          "enum": [
            "layout_conversion_evidence_report_passes",
            "layout_conversion_schema_and_golden_stable",
            "layout_conversion_negative_tests_present",
            "runtime_evidence_matrix_optional_inventory",
            "second_independent_layout_conversion_slice",
            "gate_exact_artifact_binding",
            "hs_ir_and_tensor_store_digest_binding"
          ]
        },
        "detail": {
          "$ref": "#/$defs/report_text"
        },
        "evidence_id": {
          "$ref": "#/$defs/report_text"
        },
        "status": {
          "enum": [
            "passed",
            "blocked"
          ]
        }
      },
      "required": [
        "check_name",
        "detail",
        "evidence_id",
        "status"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "issue": {
      "additionalProperties": false,
      "properties": {
        "issue_code": {
          "$ref": "#/$defs/report_text"
        },
        "subject": {
          "$ref": "#/$defs/report_text"
        }
      },
      "required": [
        "issue_code",
        "subject"
      ],
      "type": "object"
    },
    "report_text": {
      "maxLength": 512,
      "not": {
        "enum": [
          "allocation_handle",
          "backend_artifact",
          "callable",
          "command",
          "device_id",
          "device_pointer",
          "dynamic_library",
          "env",
          "environment",
          "executable",
          "file_path",
          "generated_code",
          "host_path",
          "import_module",
          "jit_function",
          "memory_address",
          "module",
          "network",
          "plugin_entrypoint",
          "pointer",
          "python_module",
          "python_source",
          "raw_benchmark_output",
          "raw_tensor_value",
          "raw_timing_samples",
          "runtime_handle",
          "source_text",
          "subprocess",
          "tensor_value",
          "url"
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    }
  }
}
