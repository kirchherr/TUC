{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/real_triton_first_slice_admission_readiness_gate_report.v0.schema.json",
  "title": "TUC Real Triton First Slice Admission Readiness Gate Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_decision",
    "admission_ready",
    "admitted",
    "already_satisfied",
    "already_satisfied_count",
    "artifact_status",
    "blocked_claims",
    "blocked_execution_surfaces",
    "blocking_reasons",
    "checked_evidence",
    "checked_evidence_count",
    "evidence_policy",
    "gate_contract",
    "gate_id",
    "gate_passed",
    "gate_status",
    "issues",
    "remaining_external_evidence",
    "remaining_external_evidence_count",
    "required_invariants",
    "schema_version",
    "source_free",
    "surface_opened",
    "target_slice",
    "target_surface"
  ],
  "properties": {
    "schema_version": {
      "const": "tuc.real_triton_first_slice_admission_readiness_gate_report.v0"
    },
    "gate_id": {
      "const": "real_triton_first_slice_admission_readiness_gate"
    },
    "gate_contract": {
      "const": "real_triton_first_slice_admission_readiness_gate.data_only.v0"
    },
    "artifact_status": {
      "const": "review_gate"
    },
    "gate_passed": {
      "const": false
    },
    "gate_status": {
      "const": "blocked_missing_maintainer_security_review_approval"
    },
    "admission_decision": {
      "const": "deny_until_external_approval"
    },
    "admission_ready": {
      "const": false
    },
    "admitted": {
      "const": false
    },
    "target_surface": {
      "const": "direct_source_ingestion"
    },
    "target_slice": {
      "const": "bounded_source_buffer_to_source_intent_plain_data"
    },
    "evidence_policy": {
      "const": "digest_only_fixed_artifact_scan"
    },
    "checked_evidence_count": {
      "const": 7
    },
    "checked_evidence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "real_triton_first_admissible_slice_plan" },
            "contract": { "const": "real_triton_first_slice_plan.data_only.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "blocked_until_admitting_source_ingestion_evidence" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "source_ingestion_maintainer_security_review_packet" },
            "contract": { "const": "source_ingestion_maintainer_security_review_packet.review.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "ready_for_maintainer_review" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "source_ingestion_maintainer_approval_artifact" },
            "contract": { "const": "source_ingestion_maintainer_approval_artifact.absent.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "external_approval_not_supplied" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "source_ingestion_admission_gate" },
            "contract": { "const": "source_ingestion_admission_gate.fail_closed.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "blocked_missing_maintainer_security_review_approval" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "first_real_triton_kernel_path" },
            "contract": { "const": "first_real_triton_kernel_path.digest_bound.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "PASS" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "real_triton_first_slice_evidence_portfolio" },
            "contract": { "const": "real_triton_first_slice_evidence_portfolio.research_boundary.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "PASS" },
            "supports_readiness_gate": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "contract", "digest", "source_free", "status", "supports_readiness_gate"],
          "properties": {
            "artifact_id": { "const": "objective_alpha_catalog_acyclicity_gate" },
            "contract": { "const": "objective_alpha.catalog_acyclicity_gate.data_only.v0" },
            "digest": { "$ref": "#/$defs/digest" },
            "source_free": { "const": true },
            "status": { "const": "PASS" },
            "supports_readiness_gate": { "const": true }
          }
        }
      ]
    },
    "already_satisfied_count": {
      "const": 7
    },
    "already_satisfied": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "const": "first_slice_plan_bound" },
        { "const": "maintainer_review_packet_ready" },
        { "const": "maintainer_approval_absence_bound" },
        { "const": "source_ingestion_admission_gate_fail_closed" },
        { "const": "first_real_triton_kernel_path_passed" },
        { "const": "first_slice_evidence_portfolio_passed" },
        { "const": "objective_alpha_catalog_acyclicity_passed" }
      ]
    },
    "remaining_external_evidence_count": {
      "const": 1
    },
    "remaining_external_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        { "const": "maintainer_security_review_approval" }
      ]
    },
    "blocking_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        { "const": "maintainer_security_review_approval_missing" }
      ]
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "arbitrary_triton_source_ingestion" },
        { "const": "production_parser" },
        { "const": "source_to_compute_graph_admission" },
        { "const": "native_backend_execution" },
        { "const": "native_performance_parity" },
        { "const": "vendor_replacement" }
      ]
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "const": "direct_source_ingestion" },
        { "const": "source_to_compute_graph" },
        { "const": "source_to_hac_ir" },
        { "const": "source_to_runtime_plan" },
        { "const": "frontend_package_import" },
        { "const": "plugin_discovery" },
        { "const": "triton_jit_execution" },
        { "const": "device_access" },
        { "const": "generated_artifact_execution" },
        { "const": "native_backend_execution" }
      ]
    },
    "required_invariants": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        { "const": "first_slice_plan_bound" },
        { "const": "maintainer_review_packet_ready" },
        { "const": "external_approval_artifact_absent" },
        { "const": "source_ingestion_admission_gate_fail_closed" },
        { "const": "first_real_kernel_path_passed" },
        { "const": "first_slice_evidence_portfolio_passed" },
        { "const": "catalog_acyclicity_passed" },
        { "const": "direct_source_ingestion_false" },
        { "const": "source_to_compute_graph_false" },
        { "const": "source_to_hac_ir_false" },
        { "const": "source_to_runtime_plan_false" },
        { "const": "surface_opened_false" },
        { "const": "digest_only_source_free_evidence" }
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 0
    },
    "source_free": {
      "const": true
    },
    "surface_opened": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
