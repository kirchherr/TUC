{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/objective_alpha_research_claim_gate_report.v0.schema.json",
  "title": "TUC Objective Alpha Research Claim Gate Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_policy",
    "backend_equivalence_passed",
    "blocked_claims",
    "broad_source_parser_claim",
    "catalog_entry_count",
    "claim_contract",
    "claim_digest",
    "claim_id",
    "claim_metadata_digest",
    "claim_scope",
    "claim_status",
    "evidence_count",
    "evidence_ids",
    "gate_contract",
    "gate_id",
    "gate_passed",
    "gate_status",
    "issues",
    "native_performance_claim",
    "public_bundle_entry_count",
    "public_evidence_entry_count",
    "reference_correctness_passed",
    "required_invariants",
    "schema_version",
    "supported_claims",
    "vendor_replacement_claim"
  ],
  "properties": {
    "schema_version": {"const": "tuc.objective_alpha_research_claim_gate_report.v0"},
    "gate_contract": {"const": "objective_alpha.research_claim_gate.ci.v0"},
    "gate_id": {"const": "objective_alpha_research_claim_gate"},
    "gate_passed": {"const": true},
    "gate_status": {"const": "PASS"},
    "claim_contract": {"const": "objective_alpha.research_claim.digest_snapshot.v0"},
    "claim_id": {"const": "objective_alpha_universal_compute_research_claim"},
    "claim_status": {"const": "supported_for_objective_alpha_research_scope"},
    "claim_scope": {"const": "objective_alpha_public_bundle_catalog_and_mixed_runtime_proof"},
    "artifact_policy": {"const": "digest_only_source_free"},
    "claim_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_metadata_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_count": {"const": 6},
    "public_bundle_entry_count": {"const": 16},
    "catalog_entry_count": {"const": 7},
    "public_evidence_entry_count": {"const": 23},
    "backend_equivalence_passed": {"const": true},
    "reference_correctness_passed": {"const": true},
    "native_performance_claim": {"const": false},
    "broad_source_parser_claim": {"const": false},
    "vendor_replacement_claim": {"const": false},
    "issues": {"type": "array", "maxItems": 0},
    "evidence_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"const": "objective_alpha_public_proof_bundle"},
        {"const": "objective_alpha_public_proof_bundle_gate"},
        {"const": "objective_alpha_evidence_extension_policy"},
        {"const": "objective_alpha_public_evidence_catalog"},
        {"const": "objective_alpha_public_evidence_catalog_admission_gate"},
        {"const": "source_intent_mixed_runtime_public_proof_bundle"}
      ]
    },
    "supported_claims": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": "hardware_independent_compute_intent_current_research_slice"},
        {"const": "capability_planned_trusted_runtime_execution"},
        {"const": "mixed_backend_public_semantics_preserved"},
        {"const": "digest_only_reviewable_public_evidence"},
        {"const": "rfc_bound_public_evidence_growth"}
      ]
    },
    "blocked_claims": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"const": "native_performance_parity"},
        {"const": "vendor_compiler_replacement"},
        {"const": "broad_source_code_parsing"},
        {"const": "arbitrary_third_party_backend_execution"},
        {"const": "device_access"},
        {"const": "generated_artifact_execution"},
        {"const": "production_triton_integration"}
      ]
    },
    "required_invariants": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"const": "public_proof_bundle_full"},
        {"const": "public_proof_bundle_gate_passed"},
        {"const": "extension_policy_passed"},
        {"const": "public_evidence_catalog_passed"},
        {"const": "public_evidence_catalog_admission_gate_passed"},
        {"const": "source_intent_mixed_runtime_public_proof_passed"},
        {"const": "backend_equivalence_passed"},
        {"const": "reference_correctness_passed"},
        {"const": "digest_only_source_free_claim"}
      ]
    }
  }
}
