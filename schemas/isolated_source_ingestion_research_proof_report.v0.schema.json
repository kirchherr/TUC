{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/isolated_source_ingestion_research_proof_report.v0.schema.json",
  "title": "TUC Isolated Source Ingestion Research Proof Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_effect",
    "artifact_digests",
    "artifact_policy",
    "backend_equivalence_passed",
    "blocked_claims",
    "direct_source_ingestion",
    "enforced_controls",
    "equivalence_comparison_metadata_digest",
    "explicit_non_claims",
    "external_package_code_executed",
    "filesystem_namespace_isolation",
    "fixed_worker_process_executed",
    "issues",
    "kernel_name",
    "kernel_network_isolation",
    "operation_families",
    "package_backend_sequence",
    "package_ids",
    "production_source_ingestion",
    "proof_claim",
    "proof_contract",
    "proof_status",
    "public_output_bundle_metadata_digest",
    "public_output_names",
    "raw_source_serialized",
    "raw_tensor_values_serialized",
    "reference_correctness_passed",
    "report_digest",
    "research_source_to_intent_plain_data",
    "schema_version",
    "source_intent_digest",
    "source_intent_payload_serialized",
    "source_name",
    "source_text_executed",
    "trusted_executor_sequence",
    "user_selected_subprocess_executed",
    "worker_contract",
    "worker_protocol",
    "worker_report_digest",
    "worker_status"
  ],
  "properties": {
    "admission_effect": { "const": "does_not_admit_production_source_ingestion" },
    "artifact_digests": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "artifact_policy": { "const": "metadata_digest_only_source_and_values_omitted" },
    "backend_equivalence_passed": { "const": true },
    "blocked_claims": {
      "const": [
        "general_triton_parser",
        "kernel_network_isolation",
        "native_backend_execution",
        "native_performance_parity",
        "production_source_ingestion",
        "production_source_sandbox"
      ]
    },
    "direct_source_ingestion": { "const": false },
    "enforced_controls": {
      "const": [
        "address_space_limit",
        "core_dump_disabled",
        "cpu_time_limit",
        "empty_working_directory",
        "file_size_limit",
        "fixed_worker_path",
        "isolated_python_mode",
        "minimal_environment",
        "open_file_limit",
        "parent_wall_clock_timeout",
        "request_byte_limit",
        "response_byte_limit",
        "shell_disabled",
        "strict_response_revalidation"
      ]
    },
    "equivalence_comparison_metadata_digest": { "$ref": "#/$defs/digest" },
    "explicit_non_claims": {
      "const": [
        "filesystem_namespace_isolation",
        "kernel_network_isolation",
        "native_code_sandbox",
        "production_source_ingestion",
        "production_source_sandbox"
      ]
    },
    "external_package_code_executed": { "const": false },
    "filesystem_namespace_isolation": { "const": false },
    "fixed_worker_process_executed": { "const": true },
    "issues": { "type": "array", "maxItems": 0 },
    "kernel_name": { "const": "matmul_elementwise" },
    "kernel_network_isolation": { "const": false },
    "operation_families": { "const": ["elementwise", "matmul"] },
    "package_backend_sequence": { "const": ["external-systolic", "external-vector"] },
    "package_ids": {
      "const": [
        "external-systolic-reference-package",
        "external-vector-reference-package"
      ]
    },
    "production_source_ingestion": { "const": false },
    "proof_claim": { "const": "bounded_source_reaches_equivalent_trusted_package_execution_through_fixed_worker" },
    "proof_contract": { "const": "isolated_source_ingestion_research_proof.e2e.v0" },
    "proof_status": { "const": "PASS" },
    "public_output_bundle_metadata_digest": { "$ref": "#/$defs/digest" },
    "public_output_names": { "const": ["y"] },
    "raw_source_serialized": { "const": false },
    "raw_tensor_values_serialized": { "const": false },
    "reference_correctness_passed": { "const": true },
    "report_digest": { "$ref": "#/$defs/digest" },
    "research_source_to_intent_plain_data": { "const": true },
    "schema_version": { "const": "tuc.isolated_source_ingestion_research_proof_report.v0" },
    "source_intent_digest": { "$ref": "#/$defs/digest" },
    "source_intent_payload_serialized": { "const": false },
    "source_name": { "const": "research_matmul_elementwise" },
    "source_text_executed": { "const": false },
    "trusted_executor_sequence": { "const": ["systolic-sim", "vector-sim"] },
    "user_selected_subprocess_executed": { "const": false },
    "worker_contract": { "const": "isolated_source_ingestion.research_non_admitting.v0" },
    "worker_protocol": { "const": "tuc.isolated_source_ingestion_worker.v0" },
    "worker_report_digest": { "$ref": "#/$defs/digest" },
    "worker_status": { "const": "research_prototype_non_admitting" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest"],
      "properties": {
        "artifact_id": {
          "enum": [
            "source_intent_module",
            "source_intent_metadata",
            "hac_ir",
            "external_systolic_integration",
            "external_vector_integration",
            "package_portfolio_execution",
            "public_output_contract",
            "public_output_bundle",
            "reference_correctness",
            "backend_equivalence"
          ]
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
