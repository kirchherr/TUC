{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuc.dev/schemas/bounded_model_artifact_bundle_integration.v0.schema.json",
  "title": "TUC Bounded Model Artifact Bundle Integration v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_contract",
    "device_access",
    "filesystem_access",
    "generated_code_execution",
    "native_compilation",
    "native_execution",
    "network_access",
    "plans",
    "plugin_discovery",
    "schema_version",
    "status",
    "subprocess_execution"
  ],
  "properties": {
    "bundle_contract": {"const": "tuc.bounded_model_artifact_bundle.v0"},
    "device_access": {"const": false},
    "filesystem_access": {"const": false},
    "generated_code_execution": {"const": false},
    "native_compilation": {"const": false},
    "native_execution": {"const": false},
    "network_access": {"const": false},
    "plans": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_sha256",
          "backend_bindings_digest",
          "bundle_bytes",
          "bundle_digest",
          "changed_bundle_digest",
          "changed_model_compilation_digest",
          "decision_report_sha256",
          "model_compilation_digest",
          "name",
          "parameters",
          "public_outputs",
          "variable_inputs"
        ],
        "properties": {
          "artifact_sha256": {
            "type": "object",
            "minProperties": 5,
            "maxProperties": 5,
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "backend_bindings_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bundle_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
          "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "changed_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "changed_model_compilation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "model_compilation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "name": {"enum": ["cpu", "cuda", "mixed"]},
          "parameters": {"const": ["w"]},
          "public_outputs": {"const": ["scores"]},
          "variable_inputs": {"const": ["x"]}
        }
      }
    },
    "plugin_discovery": {"const": false},
    "schema_version": {"const": "tuc.bounded_model_artifact_bundle_integration.v0"},
    "status": {"const": "PASS"},
    "subprocess_execution": {"const": false}
  }
}
