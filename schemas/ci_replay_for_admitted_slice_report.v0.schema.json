{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/ci_replay_for_admitted_slice_report.v0.schema.json",
  "title": "TUC CI Replay For Admitted Slice Report v0",
  "description": "Digest-only CI replay evidence for the future admitted source-to-Intent slice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_effect",
    "all_replayed",
    "artifact_policy",
    "blocked_execution_surfaces",
    "ci_binding_policy",
    "ci_checkout_credentials",
    "ci_replay_step_bound",
    "ci_workflow_digest",
    "ci_workflow_permissions",
    "contract",
    "direct_source_ingestion",
    "evidence_id",
    "issues",
    "maintainer_security_review_required",
    "remaining_external_evidence",
    "remaining_external_evidence_count",
    "replay_mode",
    "replayed_evidence",
    "replayed_evidence_count",
    "report_digest",
    "required_control_count",
    "required_controls",
    "schema_version",
    "source_ingestion_admission_ready",
    "source_to_compute_graph",
    "source_to_hac_ir",
    "source_to_runtime_plan",
    "status",
    "target_slice"
  ],
  "properties": {
    "schema_version": {"const": "tuc.ci_replay_for_admitted_slice_report.v0"},
    "evidence_id": {"const": "ci_replay_for_admitted_slice"},
    "contract": {"const": "ci_replay_for_admitted_slice.ci.v0"},
    "status": {"const": "PASS"},
    "target_slice": {"const": "bounded_source_buffer_to_source_intent_plain_data"},
    "replay_mode": {"const": "deterministic_digest_replay_only"},
    "artifact_policy": {"const": "digest_only_source_free"},
    "ci_binding_policy": {"const": "github_actions_read_only_replay"},
    "admission_effect": {"const": "does_not_admit_direct_source_ingestion"},
    "ci_workflow_digest": {"$ref": "#/$defs/sha256_text"},
    "ci_workflow_permissions": {"const": "contents_read"},
    "ci_checkout_credentials": {"const": "persist_credentials_false"},
    "ci_replay_step_bound": {"const": true},
    "all_replayed": {"const": true},
    "direct_source_ingestion": {"const": false},
    "source_ingestion_admission_ready": {"const": false},
    "source_to_compute_graph": {"const": false},
    "source_to_hac_ir": {"const": false},
    "source_to_runtime_plan": {"const": false},
    "maintainer_security_review_required": {"const": true},
    "remaining_external_evidence_count": {"const": 1},
    "replayed_evidence_count": {"const": 5},
    "required_control_count": {"const": 17},
    "report_digest": {"$ref": "#/$defs/sha256_text"},
    "issues": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "remaining_external_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"const": "maintainer_security_review_approval"}
      ],
      "items": false
    },
    "replayed_evidence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/bounded_source_buffer_api_replay"},
        {"$ref": "#/$defs/source_ingestion_sandbox_replay"},
        {"$ref": "#/$defs/parser_fuzz_negative_corpus_replay"},
        {"$ref": "#/$defs/source_free_diagnostics_replay"},
        {"$ref": "#/$defs/source_to_intent_plain_data_golden_replay"}
      ],
      "items": false
    },
    "required_controls": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "prefixItems": [
        {"const": "github_actions_permissions_contents_read"},
        {"const": "checkout_persist_credentials_false"},
        {"const": "ruff_required"},
        {"const": "mypy_required"},
        {"const": "pytest_required"},
        {"const": "admitted_slice_replay_step_required"},
        {"const": "deterministic_report_goldens_bound"},
        {"const": "source_intent_plain_data_golden_bound"},
        {"const": "digest_only_report"},
        {"const": "source_free_report"},
        {"const": "direct_source_ingestion_remains_blocked"},
        {"const": "no_source_to_compute_graph"},
        {"const": "no_source_to_hac_ir"},
        {"const": "no_source_to_runtime_plan"},
        {"const": "no_triton_jit"},
        {"const": "no_device_access"},
        {"const": "no_generated_artifacts"}
      ],
      "items": false
    },
    "blocked_execution_surfaces": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "frontend_package_import"},
        {"const": "plugin_discovery"},
        {"const": "triton_jit_execution"},
        {"const": "device_access"},
        {"const": "generated_artifact_execution"},
        {"const": "native_backend_execution"},
        {"const": "python_import"},
        {"const": "network_access"},
        {"const": "subprocess_execution"},
        {"const": "dynamic_library_loading"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256_text": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "replay_item_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "digest",
        "evidence_id",
        "replayed",
        "source_free",
        "status"
      ],
      "properties": {
        "contract": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "digest": {"$ref": "#/$defs/sha256_text"},
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "replayed": {"const": true},
        "source_free": {"const": true},
        "status": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}
      }
    },
    "bounded_source_buffer_api_replay": {
      "allOf": [
        {"$ref": "#/$defs/replay_item_base"},
        {
          "properties": {
            "contract": {"const": "bounded_source_buffer_api.execution_free.v0"},
            "evidence_id": {"const": "bounded_source_buffer_api"},
            "status": {"const": "implemented_non_admitting"}
          }
        }
      ]
    },
    "source_ingestion_sandbox_replay": {
      "allOf": [
        {"$ref": "#/$defs/replay_item_base"},
        {
          "properties": {
            "contract": {"const": "source_ingestion_sandbox_implementation.execution_free.v0"},
            "evidence_id": {"const": "source_ingestion_sandbox_implementation"},
            "status": {"const": "implemented_non_admitting"}
          }
        }
      ]
    },
    "parser_fuzz_negative_corpus_replay": {
      "allOf": [
        {"$ref": "#/$defs/replay_item_base"},
        {
          "properties": {
            "contract": {"const": "parser_fuzz_negative_corpus_for_admitting_slice.data_only.v0"},
            "evidence_id": {"const": "parser_fuzz_negative_corpus_for_admitting_slice"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    },
    "source_free_diagnostics_replay": {
      "allOf": [
        {"$ref": "#/$defs/replay_item_base"},
        {
          "properties": {
            "contract": {"const": "source_free_diagnostics_admission_tests.data_only.v0"},
            "evidence_id": {"const": "source_free_diagnostics_admission_tests"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    },
    "source_to_intent_plain_data_golden_replay": {
      "allOf": [
        {"$ref": "#/$defs/replay_item_base"},
        {
          "properties": {
            "contract": {"const": "source_to_intent_plain_data_output_golden_for_admitted_slice.data_only.v0"},
            "evidence_id": {"const": "source_to_intent_plain_data_output_golden_for_admitted_slice"},
            "status": {"const": "complete_non_admitting"}
          }
        }
      ]
    }
  }
}
