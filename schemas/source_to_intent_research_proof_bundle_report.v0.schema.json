{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirchherr/TUC/schemas/source_to_intent_research_proof_bundle_report.v0.schema.json",
  "title": "TUC Source-To-Intent Research Proof Bundle Report v0",
  "description": "Digest-only review bundle for the current Source-to-Intent research proof chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_parser_sources",
    "artifact_count",
    "artifact_policy",
    "artifacts",
    "blocked_claims",
    "bundle_contract",
    "claim",
    "default_parser_status",
    "parser_output_policy",
    "parser_status",
    "required_artifacts",
    "review_claims",
    "schema_version",
    "source_boundary",
    "status"
  ],
  "properties": {
    "accepted_parser_sources": {
      "type": "array",
      "prefixItems": [
        {"const": "research_matmul_elementwise"},
        {"const": "research_softmax_reduction"}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "artifact_count": {"const": 8},
    "artifact_policy": {"const": "digest_only_source_free"},
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "blocked_claims": {
      "type": "array",
      "prefixItems": [
        {"const": "general_triton_source_ingestion"},
        {"const": "native_performance_claim"},
        {"const": "production_parser"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "bundle_contract": {
      "const": "source_to_intent_research_proof_bundle.review.v0"
    },
    "claim": {"const": "safe_source_to_runtime_research_slice"},
    "default_parser_status": {"const": "default_parser_blocked"},
    "parser_output_policy": {"const": "source_intent.v0_plain_data_only"},
    "parser_status": {"const": "research_explicit_only"},
    "required_artifacts": {
      "type": "array",
      "prefixItems": [
        {"const": "source_to_intent_research_readiness"},
        {"const": "source_to_intent_research_parser_conformance_gate"},
        {"const": "source_to_intent_research_diagnostics"},
        {"const": "source_to_intent_research_preflight_bridge"},
        {"const": "source_to_intent_research_execution_bridge"},
        {"const": "source_to_intent_research_idiom_alignment"},
        {"const": "source_to_intent_research_source_runtime_smoke"},
        {"const": "source_to_intent_research_evidence_gate"}
      ],
      "minItems": 8,
      "maxItems": 8
    },
    "review_claims": {
      "type": "array",
      "prefixItems": [
        {"const": "default_parser_blocked"},
        {"const": "idiom_scope_bound"},
        {"const": "preflight_gated"},
        {"const": "runtime_execution_controlled"},
        {"const": "source_intent_plain_data_only"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "schema_version": {
      "const": "tuc.source_to_intent_research_proof_bundle_report.v0"
    },
    "source_boundary": {
      "const": "preflight_to_source_intent_plain_data_to_runtime"
    },
    "status": {"const": "PASS"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "contract",
        "digest",
        "status"
      ],
      "properties": {
        "artifact_id": {
          "enum": [
            "source_to_intent_research_readiness",
            "source_to_intent_research_parser_conformance_gate",
            "source_to_intent_research_diagnostics",
            "source_to_intent_research_preflight_bridge",
            "source_to_intent_research_execution_bridge",
            "source_to_intent_research_idiom_alignment",
            "source_to_intent_research_source_runtime_smoke",
            "source_to_intent_research_evidence_gate"
          ]
        },
        "artifact_kind": {"enum": ["json_report", "text_gate"]},
        "contract": {"$ref": "#/$defs/report_text"},
        "digest": {"$ref": "#/$defs/sha256_digest"},
        "status": {"const": "accepted"}
      }
    },
    "report_text": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
